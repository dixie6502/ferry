#!/usr/bin/env bash
#
# ferry — marker-model sync of personal projects to/from a cloud via rclone.
#
# A tree is a partial mirror of a remote, selected by `.ferry` marker files:
#
#   root   a directory whose `.ferry` holds the remote base ("Remote:Projects").
#          Found by walking UP from $PWD. Exactly one per tree.
#   unit   a leaf marker (empty `.ferry`, none below it). The granularity of every
#          transfer, git bundle and sync-state record.
#
# Directories between the root and a unit hold no marker; they are created on the
# way down by a deep `pull`/`new` and exist only to navigate.
#
# A node's remote path is DERIVED: <base> + <path under the root>. The base is
# stored once, at the root; nothing else stores a path.
#
# Files are kept out of every transfer by `.ferryignore`: one at the tree root
# (rules for every unit) and one per unit, both read relative to the unit. What
# is ignored is excluded from transfers AND from drift, so the two never disagree.
#
# Flags: --mirror (propagate deletions; single <dir> only), --force (skip the
# pre-transfer drift guard), -y/--yes (skip prompts), -v/--verbose (trace every
# rclone call and pass it -v). The list below shows which verb takes which.
# Flags may come anywhere; `--` ends them.
#
# Requires: bash, rclone (with the remote configured), git.

set -euo pipefail
# A command substitution runs with errexit too, so a failure inside `x=$(...)`
# fails the assignment. A substitution used as an *argument* still does not
# stop its caller — assign it first.
shopt -s inherit_errexit

readonly PROG=${0##*/}
readonly MARKER='.ferry'
readonly IGNORE_FILE='.ferryignore'

# Per-machine sync state, keyed by a unit's path under the root: an empty
# BASELINE file whose mtime is the last sync point, a MANIFEST of what the two
# sides shared at that point, and a cloud bit the prompt reads. Outside the
# synced tree so it never rides to the cloud.
readonly STATE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/ferry"
readonly BASELINE='synced_at'
readonly MANIFEST='manifest'
readonly REMOTE_BIT='remote'

# Always keep git internals and the markers themselves out of transfers. The
# marker exclusion also protects a local `.ferry` from deletion under --mirror.
# FIND_PRUNE is the same exclusion for a local `find` walk: what is never
# transferred is never part of drift either.
readonly XFER_EXCLUDE=(--exclude '.git' --exclude '.git/**' --exclude "$MARKER")
readonly GIT_PRUNE=(-name .git -prune -o)
readonly FIND_PRUNE=("${GIT_PRUNE[@]}" -name "$MARKER" -prune -o)

# The same two exclusions plus the unit's `.ferryignore` rules, compiled by
# load_ignore. Every reader of a unit's contents — transfer, drift check,
# remote listing, local walk — goes through these, never the base arrays: an
# exclusion that reached one and not the others would leave a file drifted
# forever (a stuck '>' in the prompt, a permanent 'remote add' in status).
# A reader given the unit's directory loads them itself (a memo hit when
# already loaded); pull, push and sync also load them at entry for the readers
# given only a remote. Until a load they hold the base exclusions, so a missed
# load never exposes .git.
UNIT_EXCLUDE=("${XFER_EXCLUDE[@]}")
UNIT_PRUNE=("${FIND_PRUNE[@]}")
IGNORE_LOADED=''

# Set by probe_unit: a unit's drift symbol, the per-file classification behind
# it, and what the symbol rests on:
#   compared     a full comparison against the last sync ran (DRIFT_FILES set)
#   absent       nothing on the cloud: local content alone decides
#   unbaselined  both sides may hold content, never synced from this machine
#   unreadable   the cloud could not be read (DRIFT is '?')
DRIFT=''
DRIFT_FILES=''
DRIFT_BASIS=''

# The enclosing tree, set by locate_tree: its directory, its remote base, and
# the base's key under STATE_ROOT.
ROOT=''
BASE=''
STATE_KEY=''

# See remote_hash_type.
HASH_PROBED=0
HASH_TYPE=''
HASH_WIDTH=0

# Every verb, as "<name> <arguments> — <summary>": the one source for argument
# and flag checks, help and completion. In <arguments>, `<x>` is required,
# `[<x>]` optional, a bare word literal, and `[-f|--flag]` a flag the verb
# takes; COMMON_FLAGS go with every verb. ($PWD is text here, not expanded.)
# shellcheck disable=SC2016
readonly VERBS=(
    'init <remote:path> — make $PWD a root holding <remote:path> (no nested roots)'
    'list [<dir>] — remote children of a node (no local dir needed)'
    'status [<dir>] — drift for every unit at/under <dir> or $PWD'
    'resolve [<dir>] — stage the cloud side of a conflict, to compare by hand'
    'sync [<dir>] — converge a unit both ways (additive; conflicts stay put)'
    'pull [--mirror] [--force] [<dir>] — materialize a unit; no <dir> → every unit under $PWD'
    'push [--mirror] [--force] [<dir>] — send a unit up; no <dir> → every unit under $PWD'
    'new <name> — start a BRAND-NEW unit (cloud prefix on first push)'
    'mv <old> <new> — rename/move a unit or grouping dir (cloud first, then local)'
    'drop [-y|--yes] [<dir>] — delete LOCAL only; the cloud keeps its copy'
    'rm [-y|--yes] <dir> — delete a unit BOTH sides (confirmation-gated)'
    'completion bash — emit a bash completion script (eval from your shell rc)'
    'help — this help'
)
readonly COMMON_FLAGS='-v --verbose -h --help'

# --mirror: propagate deletions (single-unit push/pull only).
# --force: skip the pre-transfer drift guard (and the probe it costs).
# --yes: skip confirmation prompts.
MIRROR=0
FORCE=0
YES=0

# --verbose: echo each rclone command and let rclone log at INFO.
# STEPS: announce each phase of a unit's run (set by run_units, resolve and
# --verbose), so a slow cloud reads as slow, not as hung.
VERBOSE=0
STEPS=0

# File descriptor for step and trace lines: the terminal's stderr, saved by
# main before any function redirects fd 2 into a capture.
LOG_FD=2

# --- helpers ----------------------------------------------------------------
# Messages, prefixed with the program name: printf-style, a newline added.
info() { local format=$1; shift; printf "%s: $format\n" "$PROG" "$@"; }
warn() { info "$@" >&2; }
die()  { warn '%s' "$*"; exit 1; }

require() { command -v "$1" >/dev/null || die "$1 not found"; }

# Announce a phase of the current unit's run (see STEPS).
step() {
    [ "$STEPS" = 1 ] || return 0
    info '  %s' "$*" >&"$LOG_FD"
}

# Pass stdin through unchanged while counting its lines under the current step
# (see STEPS): a listing or hashing run that takes minutes shows it is moving.
# Live on a terminal, redrawn each second; elsewhere a line every 10s. Silent
# when the run is quick — a count appears only once a full interval has passed.
tally() {   # <what one line is, e.g. "files listed">
    if [ "$STEPS" != 1 ]; then cat; return; fi
    local line n=0 shown=0 interval=1 last=$SECONDS lead=$'\r' tail=''
    [ -t "$LOG_FD" ] || { interval=10 lead='' tail=$'\n'; }
    while IFS= read -r line || [ -n "$line" ]; do
        printf '%s\n' "$line"
        n=$((n + 1))
        if (( SECONDS - last >= interval )); then
            printf '%s%s:     %d %s%s' "$lead" "$PROG" "$n" "$1" "$tail" >&"$LOG_FD"
            last=$SECONDS shown=1
        fi
    done
    [ "$shown" = 1 ] || return 0
    printf '%s%s:     %d %s\n' "$lead" "$PROG" "$n" "$1" >&"$LOG_FD"
}

# --- rclone -----------------------------------------------------------------
# Every rclone call goes through run_rclone, which traces it under --verbose
# (main exports RCLONE_VERBOSE for rclone's own logging).
#
# --fast-list: one recursive listing instead of one per directory. Beyond
# fewer requests, it is what carries hashes on backends whose per-directory
# listing omits them; without it every hash a check, listing or --checksum
# transfer reads costs a lookup per file (7416 files: 6s with it, many minutes without). Without
# the flag, rclone lists per directory whenever a directory exclusion is in
# play — and UNIT_EXCLUDE always holds '.git/**'. Backends without a recursive
# listing ignore it. A user's RCLONE_FAST_LIST is left to rule, as flags
# outrank it.
run_rclone() {
    local -a list=()
    [ -n "${RCLONE_FAST_LIST:-}" ] || list=(--fast-list)
    if [ "$VERBOSE" = 1 ]; then
        printf '%s: + rclone%s\n' "$PROG" "$(printf ' %q' ${list[@]+"${list[@]}"} "$@")" >&"$LOG_FD"
    fi
    rclone ${list[@]+"${list[@]}"} "$@"
}

# Short limits for the calls that read the cloud before anything moves.
# rclone's defaults (1m connect timeout, 5m idle timeout, 3 retries of 10
# low-level retries each) can keep an unreachable cloud silent for many
# minutes; these fail within about a minute. Transfers keep the defaults: they
# show progress, and their retries ride out rate limits and slow finalising.
# Flags outrank rclone's environment, so a limit the user set there is left out.
run_rclone_probe() {
    local -a limits=()
    [ -n "${RCLONE_CONTIMEOUT:-}" ]        || limits+=(--contimeout 15s)
    [ -n "${RCLONE_TIMEOUT:-}" ]           || limits+=(--timeout 1m)
    [ -n "${RCLONE_RETRIES:-}" ]           || limits+=(--retries 1)
    [ -n "${RCLONE_LOW_LEVEL_RETRIES:-}" ] || limits+=(--low-level-retries 3)
    run_rclone ${limits[@]+"${limits[@]}"} "$@"
}

# Print a finished rclone call's held-back log, prefixed: when it failed ($1=1),
# so the failure names its cause (auth, quota, network) instead of collapsing
# into "cannot read the cloud"; and under --verbose, always.
show_rclone_log() {   # <is failure: 0|1> <log>
    [ "$1" = 1 ] || [ "$VERBOSE" = 1 ] || return 0
    if [ -n "$2" ]; then sed "s/^/$PROG: rclone: /" <<<"$2" >&2; fi
}

# run_rclone_probe with stderr held back for show_rclone_log: a probe that succeeds
# stays quiet, one that fails says why. Stdout passes through.
rclone_quiet() { rclone_expect 0 "$@"; }

# The same, for a call whose listed exit statuses are all answers the caller
# handles (rclone's 3: "not found"): its log is shown only for any other status.
rclone_expect() {   # <expected statuses, comma-separated> <rclone args>...
    local expected=",$1," err status=0 failed=1; shift
    { err=$(run_rclone_probe "$@" 2>&1 >&3 3>&-); } 3>&1 || status=$?
    [[ $expected != *",$status,"* ]] || failed=0
    show_rclone_log "$failed" "$err"
    return "$status"
}

# Reject absolute paths and '..' traversal in a user-supplied name.
validate_name() {
    case "$1" in
        '')   die "empty name" ;;
        /*)   die "name must be relative, got '$1'" ;;
        *..*) die "'..' not allowed in '$1'" ;;
    esac
}

# Prompt for confirmation unless -y was given; abort on anything but yes,
# end of input included. The prompt goes to stderr, visible when stdout is not.
confirm() {
    local reply=''
    [ "$YES" = 1 ] && return 0
    printf '%s [y/N] ' "$1" >&2
    read -r reply || true
    case "$reply" in [yY]|[yY][eE][sS]) return 0 ;; *) die "aborted" ;; esac
}

# --- tree discovery (walk up) -----------------------------------------------
# Locate the enclosing tree: the nearest ancestor (incl. $PWD) whose marker has
# content. Sets ROOT (its directory) and BASE (the remote base). Returns 1 if
# $PWD is not inside any tree, so callers like `init` can branch; dies on a
# root marker that holds no remote base.
locate_tree() {
    local dir; dir=$(pwd -P)
    while :; do
        if [ -s "$dir/$MARKER" ]; then
            ROOT=$dir
            IFS= read -r BASE < "$dir/$MARKER" || true
            BASE=${BASE%$'\r'}
            is_remote_base "$BASE" || die "$dir/$MARKER holds no remote base ('remote:path'): '$BASE'"
            STATE_KEY=$(state_key "$BASE")
            return 0
        fi
        [ "$dir" != / ] || return 1
        dir=$(dirname "$dir")
    done
}

# True if a root marker's content is a usable remote base: "remote:path" (no
# '/' in the remote name, else rclone reads a local path) or an rclone
# connection string ":backend:path".
is_remote_base() {
    local name=${1%%:*}
    [[ $1 == *:* ]] || return 1
    if [ -z "$name" ]; then [[ $1 == :?*:* ]]
    else [[ $name != */* ]]; fi
}

# Same, but die when there is no enclosing tree; also adopts legacy state.
find_root() {
    locate_tree || die "not inside a ferry tree (no rooted $MARKER above $PWD)"
    adopt_legacy_state
}

# --- derivations (no I/O) ---------------------------------------------------
# A node's remote path, derived from its position under the root.
remote_of() {
    local rel=${1#"$ROOT"}; rel=${rel#/}
    if [ -n "$rel" ]; then printf '%s/%s' "$BASE" "$rel"; else printf '%s' "$BASE"; fi
}

# A node's path under the root — the key for sync state and user-facing labels.
spec_of() { local rel=${1#"$ROOT"}; printf '%s' "${rel#/}"; }

# Absolute path of an optional <dir> argument (relative to $PWD), or $PWD itself.
# Normalized lexically — '.' segments and repeated or trailing '/' dropped — so
# `proj/` (as tab completion writes it), `./proj` and `proj` name one node: the
# path keys sync state, the remote path and anchored ignore rules alike. The
# target need not exist yet (new/pull create it).
resolve_target() {
    local path rest=${1:-} part; path=$(pwd -P)
    [ -z "$rest" ] || validate_name "$rest"
    while [ -n "$rest" ]; do
        part=${rest%%/*}
        case $rest in */*) rest=${rest#*/} ;; *) rest='' ;; esac
        case $part in ''|.) ;; *) path+=/$part ;; esac
    done
    printf '%s' "$path"
}

# --- marker-tree topology ---------------------------------------------------
# True if a directory holds a marker in a subdirectory (depth >= 2, so its own
# dir/.ferry does not count) — i.e. it is a grouping node, not a leaf.
# (`-path <dir>/*/` rather than -mindepth 2, which would keep a top-level .git
# from being pruned.)
has_sub_marker() {
    [ -n "$(find "$1" "${GIT_PRUNE[@]}" \
        -path "$(escape_find_glob "$1")/*/$MARKER" -type f -print -quit)" ]
}

# A unit = a directory with an EMPTY marker (the root marker has content) that is
# a leaf of the marker tree.
is_unit() { [ -f "$1/$MARKER" ] && [ ! -s "$1/$MARKER" ] && ! has_sub_marker "$1"; }

# The nearest unit at or above a directory (stopping below the root), if any —
# i.e. whether the directory sits inside already-materialized content. A unit
# marker is empty; the root marker has content, so the root never matches.
enclosing_unit() {
    local dir=$1
    while [ "$dir" != / ] && [ "$dir" != "$ROOT" ]; do
        if [ -f "$dir/$MARKER" ] && [ ! -s "$dir/$MARKER" ]; then printf '%s' "$dir"; return 0; fi
        dir=$(dirname "$dir")
    done
    return 1
}

# Refuse to create/fetch a target that would sit inside an existing unit.
refuse_in_unit() {
    local unit; if unit=$(enclosing_unit "$(dirname "$1")"); then
        die "inside unit '$(spec_of "$unit")' — already materialized content"
    fi
}

# Confer (or refresh) unit status: an empty marker. Never over the root's
# marker, which holds the base — emptying it would unroot the whole tree.
claim_unit() {
    [ ! -s "$1/$MARKER" ] || die "$1 holds a root marker; not making it a unit"
    : > "$1/$MARKER"
}

# The unit a single-<dir> pull or push acts on. It need not exist yet (a pull
# fetches it), but it is never a root (this tree's, or one nested in it) or a
# grouping node: a transfer there would move every unit below as one, and
# claiming it would empty the root's marker. Dies otherwise — before anything
# moves, where claim_unit only catches it after.
transfer_target() {
    local target; target=$(resolve_target "$1")
    [ ! -s "$target/$MARKER" ] || die "'$1' is a tree root, not a unit; run without <dir> to act on every unit"
    if ! is_unit "$target"; then
        if [ -d "$target" ] && has_sub_marker "$target"; then
            die "'$(spec_of "$target")' is a grouping node; name one of its units"
        fi
        refuse_in_unit "$target"
    fi
    printf '%s' "$target"
}

# Refuse to act on a path the shell is standing inside (a move/delete would
# leave $PWD on a dead directory).
refuse_cwd_inside() {
    local here target; here=$(pwd -P)
    target=$(cd "$1" 2>/dev/null && pwd -P || printf '%s' "$1")
    case "$here/" in "$target/"*) die "cd out of $1 first" ;; esac
}

# Every unit at/under a directory (walk down): EMPTY-marker dirs (the root's
# content marker is excluded by -empty) with no marker dir below them. One line
# per absolute unit path.
units_under() {
    local -a marker_dirs; local dir other leaf
    mapfile -t marker_dirs < <(find "$1" "${GIT_PRUNE[@]}" \
        -name "$MARKER" -type f -empty -printf '%h\n' | sort)
    for dir in "${marker_dirs[@]}"; do
        leaf=1
        for other in "${marker_dirs[@]}"; do
            [ "$other" = "$dir" ] && continue
            case "$other/" in "$dir/"*) leaf=0; break ;; esac
        done
        [ "$leaf" = 1 ] && printf '%s\n' "$dir"
    done
}

# --- ignore rules -----------------------------------------------------------
# `.ferryignore` keeps files out of a unit — the general form of the `.git` and
# `.ferry` exclusions above. One file may sit at the tree root (rules for every
# unit) and one in each unit; both are read RELATIVE TO THE UNIT, so a rule
# written at the root anchors at each unit's own top.
#
# `.gitignore` is deliberately not consulted (see ARCHITECTURE.md, "Ignore
# rules"): not versioning a file is a different question from not backing it up.
#
# The grammar is restricted to what `find` and rclone match IDENTICALLY, because
# both must apply it (see UNIT_EXCLUDE). Blank lines and `#` comments are
# skipped; everything else is one of:
#
#   name          a file or directory called `name`, at any depth
#   name/         a directory called `name`, at any depth
#   *.ext         a glob (`*`, `?`, `[...]`, `[^...]`) over a name, at any depth
#   /a/b, /a/b/   a literal path from the unit's top
#
# Rejected, loudly: `!` re-inclusion (rclone's `--exclude` has no equivalent),
# `{a,b}` alternation and `[!...]` negation (rclone reads them, `find` does not
# or reads them differently), `**` (a bare name already matches at any depth),
# and an unanchored `a/b` (gitignore anchors it, rclone does not — so it must
# be written `/a/b`). An anchored pattern must be literal: `find -path` lets
# `*` cross a `/` and rclone does not, so a glob there would mean two things.

# Quote the characters `find -path` reads as glob metacharacters, so a literal
# directory prefix never turns into a pattern.
escape_find_glob() {
    local s=$1 out='' i c
    for (( i = 0; i < ${#s}; i++ )); do
        c=${s:i:1}
        case $c in '\'|'['|']'|'*'|'?') out+='\' ;; esac
        out+=$c
    done
    printf '%s' "$out"
}

# Append one ignore file's rules (stdin) to UNIT_EXCLUDE / UNIT_PRUNE, anchored
# at $2; $1 names the file in errors.
# A malformed pattern is fatal: continuing would transfer files the user asked
# to keep out, and a silently-dropped rule is exactly the kind of divergence
# between the two consumers this design exists to prevent.
#
# rclone needs both `p` and `p/**` to cover "file or directory called p" — a
# bare `--exclude p` skips the file but still descends the directory. `find`
# needs neither: `-name p -prune` covers both.
compile_ignore() {   # <ignore file label> <unit dir>   (rules on stdin)
    local file=$1 dir=$2 line pat dironly
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        case $line in '#'*|*[![:space:]]*) ;; *) continue ;; esac   # blank
        case $line in '#'*) continue ;; esac

        pat=$line dironly=0
        case $pat in */) dironly=1; pat=${pat%/} ;; esac
        case $pat in
            '')     die "$file: '$line' — empty pattern" ;;
            '!'*)   die "$file: '$line' — re-inclusion ('!') is not supported" ;;
            *'**'*) die "$file: '$line' — '**' is not supported; a bare name already matches at any depth" ;;
            *[{}]*) die "$file: '$line' — '{a,b}' alternation is not supported; write one pattern per line" ;;
            *'[!'*) die "$file: '$line' — '[!...]' is not supported; write the negation as '[^...]'" ;;
            *[[:space:]]) die "$file: '$line' — trailing whitespace would be part of the pattern" ;;
        esac

        if [[ $pat == */* ]]; then
            case $pat in
                /*) ;;
                *)  die "$file: '$line' — a pattern holding '/' must be anchored to the unit: write '/$pat'" ;;
            esac
            case $pat in
                *[][*?]*) die "$file: '$line' — an anchored pattern must be literal (no '*', '?' or '[')" ;;
            esac
            UNIT_PRUNE+=(-path "$(escape_find_glob "$dir$pat")")
        else
            UNIT_PRUNE+=(-name "$pat")
        fi
        [ "$dironly" = 1 ] && UNIT_PRUNE+=(-type d)
        UNIT_PRUNE+=(-prune -o)

        [ "$dironly" = 1 ] || UNIT_EXCLUDE+=(--exclude "$pat")
        UNIT_EXCLUDE+=(--exclude "$pat/**")
    done
}

# Compile the rules that apply to one unit into UNIT_EXCLUDE / UNIT_PRUNE.
# Memoized per unit: every per-unit entry point calls it, and a walk visits each
# unit once. The unit's own file is read last, so it extends the root's rules.
#
# $2 (pull only) is the unit's remote. A unit holding no local rules then takes
# the cloud's: they are what the pull brings down, and a first pull has no
# local copy yet — without this it would list, hash and download everything
# the unit's own file keeps out (a whole .venv). A cloud that cannot be read
# fails the load rather than reading as "no rules".
#
# A load with a remote always runs: an earlier local-only load of the same unit
# (sync, before it hands a first pull over) left the cloud's rules out.
load_ignore() {   # <unit dir> [<remote>]
    local dir=$1 remote_path=${2:-} unit_rules rules status=0
    [ -n "$remote_path" ] || [ "$IGNORE_LOADED" != "$dir" ] || return 0
    UNIT_EXCLUDE=("${XFER_EXCLUDE[@]}")
    UNIT_PRUNE=("${FIND_PRUNE[@]}")
    if [ -n "$ROOT" ] && [ -f "$ROOT/$IGNORE_FILE" ]; then
        compile_ignore "$ROOT/$IGNORE_FILE" "$dir" < "$ROOT/$IGNORE_FILE"
    fi
    unit_rules=$dir/$IGNORE_FILE
    if [ -f "$unit_rules" ]; then
        compile_ignore "$unit_rules" "$dir" < "$unit_rules"
    elif [ -n "$remote_path" ]; then
        # rclone answers 3 for a missing file and for a missing prefix alike.
        rules=$(rclone_expect 0,3 cat "$remote_path/$IGNORE_FILE") || status=$?
        case $status in
            0) compile_ignore "$remote_path/$IGNORE_FILE" "$dir" <<<"$rules" ;;
            3) ;;
            *) return 1 ;;
        esac
    fi
    IGNORE_LOADED=$dir
}

# --- cloud probes & sync state ----------------------------------------------
# Whether a remote path is there: 0 present, 1 absent, 2 could not tell. Failing
# to *look* must never read as absence — that turns an unreachable cloud into a
# confident "nothing on the cloud". rclone answers "directory not found" (3) both
# for a path that is not there and for one behind an unreadable parent, so those
# two stay conflated; every other failure is reported as trouble.
remote_presence() {
    local status=0
    rclone_expect 0,3 lsjson "$1" >/dev/null || status=$?
    case $status in 0) return 0 ;; 3) return 1 ;; *) return 2 ;; esac
}

# The hash algorithm the remote maintains, left in HASH_TYPE (rclone's
# preferred, first listed; empty when it holds none). Each manifest records it,
# so ancestors are always compared with the algorithm they were captured with.
# Probed once — the base is fixed for a run. A failed probe fails rather than
# recording "no hashes": that would silently downgrade a hash-capable backend
# to the mtime fallback for a whole sync cycle.
remote_hash_type() {
    [ "$HASH_PROBED" = 1 ] && return 0
    local out flat hash=''
    out=$(rclone_quiet backend features "$BASE") || return 1
    flat=$(tr -d '\n\t" ' <<<"$out")
    case $flat in *Hashes:\[*) hash=${flat#*Hashes:[}; hash=${hash%%]*}; hash=${hash%%,*} ;; esac
    HASH_TYPE=$hash HASH_PROBED=1
}

# State is keyed by the remote base as well as the unit path. Two trees can hold
# the same unit name against different remotes, and a shared key would let one
# tree's manifest and baseline answer the other's questions — with --mirror
# acting on the answer. Percent-encoding keeps the key injective: substituting
# every unsafe byte with '_' maps ':x/a_b' and ':x/a/b' onto one directory.
# Byte-wise (LC_ALL=C): per character, a code point past 0xFF prints as more
# than two hex digits ('€' → %20AC, as ' AC' also encodes) and the key would
# change with the caller's locale. ferry-prompt.sh encodes the same way.
state_key() { local LC_ALL=C; percent_encode "$1"; }

# Percent-encode every character outside [A-Za-z0-9._-], per character of the
# current locale.
percent_encode() {
    local s=$1 out='' i c
    for (( i = 0; i < ${#s}; i++ )); do
        c=${s:i:1}
        case $c in
            [A-Za-z0-9._-]) out+=$c ;;
            *) printf -v c '%%%02X' "'$c"; out+=$c ;;
        esac
    done
    printf '%s' "$out"
}

state_path() { printf '%s/%s/%s' "$STATE_ROOT" "$STATE_KEY" "$1"; }

# Move state recorded under the pre-byte-wise key (encoded per character in the
# user's locale) to STATE_KEY, once. Left in place, a non-ASCII base would lose
# every baseline, and the guard would then demand --force for every unit.
# Delete once no such state remains.
adopt_legacy_state() {
    local legacy; legacy=$(percent_encode "$BASE")
    [ "$legacy" != "$STATE_KEY" ] || return 0
    [ -d "$STATE_ROOT/$legacy" ] && [ ! -e "$STATE_ROOT/$STATE_KEY" ] || return 0
    mv "$STATE_ROOT/$legacy" "$STATE_ROOT/$STATE_KEY"
}

# How the cloud stood at the last look, and when — the bit the prompt renders.
record_remote_bit() { printf '%s %s\n' "$2" "$(date +%s)" > "$1/$REMOTE_BIT"; }

# Every cloud file of a unit, one "<mtime>;<path>" line each — an mtime holds
# no ';', so the first field always splits cleanly off a path that may.
# Returns non-zero if the listing failed.
# Times are rendered in UTC: local-time strings go backwards across a DST
# fall-back, and the baseline cutoff compares them lexicographically.
# No hashes here: a backend may look each one up with its own request (and
# may still find none for a file uploaded without rclone), and a listing
# makes those requests one at a time. Hashes come from hash_paths/remote_hashes.
remote_listing() {   # <remote>
    step 'listing the cloud'
    TZ=UTC rclone_quiet lsf -R --files-only --format tp --separator ';' \
        --time-format max "${UNIT_EXCLUDE[@]}" "$1" | tally 'files listed'
}

# `rclone hashsum`, always in hex. Manifests store digests across runs and
# the parsers read hex, so RCLONE_BASE64 in the environment must not switch the
# encoding: a flag outranks it.
rclone_hashsum() { rclone_quiet hashsum --base64=false "$@"; }

# `rclone hashsum` output ("<hash>  <path>") for the paths on stdin, one per
# line, under a local dir or a remote — looked up in parallel (--checkers).
# Returns non-zero if rclone failed.
hash_paths() {   # <hash type> <local dir or remote>
    rclone_hashsum "$1" --files-from-raw - "$2" | tally 'files hashed'
}

# The same for every file of a unit on the cloud, under the unit's exclusions.
remote_hashes() {   # <hash type> <remote>
    step 'reading cloud hashes'
    rclone_hashsum "$1" "${UNIT_EXCLUDE[@]}" "$2" | tally 'files hashed'
}

# Split one `rclone hashsum` line, "<digest>  <path>", into the caller's
# line_hash / line_path. A digest is bare hex, so its first double space ends
# it. rclone right-aligns the digest in a fixed-width field and leaves it blank
# for an object the backend holds no hash for; that line is cut by the field's
# width — never by stripping spaces, which a path may start with. The width is
# learned once, from a local hash of empty input, when a blank line first needs it.
split_hashsum_line() {   # <line>
    local digest=${1%%  *}
    case $digest in
        ''|*[!0-9a-f]*) ;;
        *) line_hash=$digest line_path=${1#*  }; return 0 ;;
    esac
    if [ "$HASH_WIDTH" = 0 ]; then
        digest=$(printf '' | rclone_hashsum "$HASH_TYPE" -) ||
            { warn 'cannot learn the %s digest width from rclone' "$HASH_TYPE"; return 1; }
        digest=${digest%%  *}
        HASH_WIDTH=${#digest}
    fi
    line_hash='' line_path=${1:HASH_WIDTH+2}
}

# Fill the named map with path → hash from `rclone hashsum` output (stdin),
# skipping objects without a digest (a blank field starts the line with a
# space), so no field width is ever needed here.
read_hashes() {   # <map name>
    local -n into=$1; local line line_hash line_path
    while IFS= read -r line; do
        case $line in ''|' '*) continue ;; esac
        split_hashsum_line "$line"
        # shellcheck disable=SC2004  # an associative map behind a nameref
        [ -z "$line_hash" ] || into[$line_path]=$line_hash
    done
}

# One side of a unit, sorted, as manifest raw material. The local side is bare
# paths; the remote side is "<hash> <path>" lines hashed with HASH_TYPE, the
# hash empty where none is known — from one `hashsum` pass when HASH_TYPE is
# set, else from a listing. Returns non-zero if the side could not be listed.
list_side() {   # <local|remote> <dir or remote>
    case "$1" in
        local)  load_ignore "$2"
                find "$2" "${UNIT_PRUNE[@]}" -type f -printf '%P\n' | sort ;;
        remote) local output line line_hash line_path
                if [ -n "$HASH_TYPE" ]; then
                    output=$(remote_hashes "$HASH_TYPE" "$2") || return 1
                    output=$(while IFS= read -r line; do
                                 [ -n "$line" ] || continue
                                 split_hashsum_line "$line" || exit 1
                                 printf '%s %s\n' "$line_hash" "$line_path"
                             done <<<"$output") || return 1
                    sort -t' ' -k2 <<<"$output"
                else
                    output=$(remote_listing "$2") || return 1
                    [ -z "$output" ] || sed 's/^[^;]*;/ /' <<<"$output" | sort -t' ' -k2
                fi ;;
    esac
}

# A manifest headed by its version and hash type, over "<hash> <path>" lines.
# 'none' spells the empty hash type only here and in read_manifest.
format_manifest() { printf '#ferry v2 %s\n%s' "${1:-none}" "$2"; }

# Read a manifest into the named variables: its hash type, and path → 1 /
# path → ancestor hash maps. v2 gives membership and ancestor hashes; a v1
# manifest (bare paths, pre-hash) gives membership only, every ancestor unknown.
read_manifest() {   # <file> <hash type var> <membership map> <ancestor map>
    local -n type_out=$2 synced_out=$3 ancestor_out=$4
    local line first=1 v2=0
    type_out=''
    while IFS= read -r line; do
        if [ "$first" = 1 ]; then
            first=0
            case $line in
                '#ferry v2 '*) v2=1; type_out=${line##* }
                               [ "$type_out" != none ] || type_out=''
                               continue ;;
            esac
        fi
        [ -n "$line" ] || continue
        # shellcheck disable=SC2004  # associative maps behind namerefs
        if [ "$v2" = 1 ]; then synced_out[${line#* }]=1; ancestor_out[${line#* }]=${line%% *}
        else synced_out[$line]=1; fi
    done < "$1"
}

# Keep the manifest body lines whose path appears in a newline-separated set.
intersect_manifest() {   # <paths> <manifest body>
    local -A keep=(); local p line
    while IFS= read -r p; do [ -n "$p" ] && keep[$p]=1; done <<<"$1"
    while IFS= read -r line; do
        if [ -n "$line" ] && [ -n "${keep[${line#* }]:-}" ]; then
            printf '%s\n' "$line"
        fi
    done <<<"$2"
}

# Record a sync point for a unit: the MANIFEST of ancestors (the paths, with
# hashes in a v2 manifest, present on BOTH sides at this sync), a prompt bit
# ($3, 'sync' unless the caller still holds conflicts), and the baseline whose
# mtime the mtime fallback measures from. Callers capture the manifest's paths
# BEFORE their transfer; the baseline is stamped here, at completion, so the
# sync's own writes never read as later changes. The manifest is replaced
# atomically. See ARCHITECTURE.md, "Drift classification".
mark_synced() {   # <spec> <manifest> [<prompt bit>]
    local manifest=$2 bit=${3:-sync} state_dir
    state_dir=$(state_path "$1")
    mkdir -p "$state_dir" || return 1
    { printf '%s\n' "$manifest" > "$state_dir/$MANIFEST.tmp" &&
      mv "$state_dir/$MANIFEST.tmp" "$state_dir/$MANIFEST"; } || return 1
    : > "$state_dir/$BASELINE"          # touched last: newer than everything it covers
    record_remote_bit "$state_dir" "$bit"
}

# True if any unit at or under a node shared a file with the cloud at its last
# sync: a manifest holding a line that is neither its header nor blank.
has_shared_files() {   # <spec>
    grep -rqs --include="$MANIFEST" -v -e '^#ferry ' -e '^$' "$(state_path "$1")"
}

# True if a unit holds any transferable file (markers and git internals aside).
has_local_content() {
    [ -d "$1" ] || return 1
    load_ignore "$1"
    [ -n "$(find "$1" "${UNIT_PRUNE[@]}" -type f -print -quit)" ]
}

# Did one side change a file since the last sync? Judged against the recorded
# ancestor hash when both hashes are in hand, else by whether that side's
# mtime moved past the baseline (v1 manifests, hashless entries).
side_changed() {   # <current hash> <ancestor hash> <moved past baseline: 1 or ''>
    if [ -n "$1" ] && [ -n "$2" ]; then [ "$1" != "$2" ]
    else [ -n "$3" ]; fi
}

# Which files of a unit differ from the cloud: `rclone check --combined` lines,
# "<flag> <path>" with flag + (local only), - (cloud only), * (differs) or !
# (unreadable); identical files are left out. Returns non-zero, printing
# rclone's log, when anything went unread.
#
# rclone exits 1 both for "differences found" and for trouble, and reports a
# directory it could not list as a whole subtree missing on the far side — a
# forged presence change. Its error counter tallies each difference plus each
# real failure, so an excess over the difference count means something went
# unread, and a summary the counters cannot be read from is trouble too. Report
# and log share one stream: a report line is "<flag> <path>", a log line starts
# with rclone's timestamp — pinned by --log-format against RCLONE_LOG_FORMAT.
check_differences() {   # <dir> <remote>
    local output status=0 differences errors trouble=0
    output=$(run_rclone_probe check --combined - --log-format 'date,time' \
        "${UNIT_EXCLUDE[@]}" "$1" "$2" 2>&1) || status=$?
    if [ "$status" -gt 1 ]; then trouble=1
    elif [ "$status" = 1 ]; then
        # Counters come only from the timestamped NOTICE summary lines, matched
        # to the line's end — a path such as "0 errors while checking.txt"
        # could otherwise spoof them.
        differences=$(sed -nE \
            's|^[0-9]{4}/.* NOTICE: .*[^0-9]([0-9]+) differences found$|\1|p' \
            <<<"$output" | tail -1)
        errors=$(sed -nE \
            's|^[0-9]{4}/.* NOTICE: .*[^0-9]([0-9]+) errors while checking$|\1|p' \
            <<<"$output" | tail -1)
        if [ -z "$differences" ] || [ "${errors:-0}" -gt "$differences" ]; then trouble=1; fi
    fi
    show_rclone_log "$trouble" "$(sed -nE '/^[0-9]{4}\//p' <<<"$output")"
    [ "$trouble" = 0 ] || return 1
    grep -E '^[-+*!] ' <<<"$output" || true
}

# Per-file drift for a unit, one "<class> <shape> <path>" line per differing
# file. Class: `local` (changed here since the last sync), `remote` (changed on
# the cloud) or `both` (a conflict). Shape: `edit` (on both sides) or
# `add`/`delete` (one side only) — what a transfer could destroy.
#
# Direction is relative to the last sync: a side changed a file iff its hash
# differs from the manifest's ancestor hash, falling back to its mtime against
# the baseline where a hash is missing. A one-sided file is attributed by
# manifest membership, never by mtimes. What is unknown — an unreadable file
# ('!'), a difference neither side's hash explains — reads `both`, so it
# blocks. The full rule tables are in ARCHITECTURE.md, "Drift classification".
#
# Returns non-zero if the cloud could not be read; the caller must not read
# that as "no differences" (see probe_unit).
classify_unit() {
    local dir=$1 remote_path=$2 state_dir=$3 baseline=$3/$BASELINE
    local -A synced=() ancestor=() local_moved=() local_hash=() remote_moved=() remote_hash=()
    local manifest_type line flag class shape path ancestor_hash index local_changed remote_changed
    load_ignore "$dir"
    read_manifest "$state_dir/$MANIFEST" manifest_type synced ancestor

    local report
    report=$(check_differences "$dir" "$remote_path") || return 1

    # Split each "<flag> <path>" line (a path may hold spaces).
    local -a flags=() paths=()
    local -A flagged=()
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        flags+=("${line:0:1}"); paths+=("${line:2}"); flagged[${line:2}]=1
    done <<<"$report"
    [ ${#paths[@]} -gt 0 ] || return 0    # nothing differs
    step "${#paths[@]} file(s) differ"

    # Which side decides each flag: both for a file on both sides, the
    # surviving side for a one-sided file shared at the last sync (an unshared
    # one is an add, whatever changed). The current hash is the primary
    # evidence, read only where an ancestor hash exists to compare with; a
    # deciding side left without one falls back to mtimes. A failed cloud
    # lookup is trouble; a failed local one only means the fallback.
    local -a local_deciding=() remote_deciding=() local_needed=() remote_needed=()
    for index in "${!paths[@]}"; do
        path=${paths[$index]}
        case ${flags[$index]} in
            '*') local_deciding+=("$path"); remote_deciding+=("$path") ;;
            '+') [ -z "${synced[$path]:-}" ] || local_deciding+=("$path") ;;
            '-') [ -z "${synced[$path]:-}" ] || remote_deciding+=("$path") ;;
        esac
    done
    for path in ${local_deciding[@]+"${local_deciding[@]}"}; do
        [ -z "${ancestor[$path]:-}" ] || local_needed+=("$path")
    done
    for path in ${remote_deciding[@]+"${remote_deciding[@]}"}; do
        [ -z "${ancestor[$path]:-}" ] || remote_needed+=("$path")
    done
    if [ ${#remote_needed[@]} -gt 0 ]; then
        step "reading ${#remote_needed[@]} cloud hash(es)"
        local sums
        sums=$(printf '%s\n' "${remote_needed[@]}" | hash_paths "$manifest_type" "$remote_path") || return 1
        read_hashes remote_hash <<<"$sums"
    fi
    if [ ${#local_needed[@]} -gt 0 ]; then
        step "hashing ${#local_needed[@]} local file(s)"
        read_hashes local_hash < <(printf '%s\n' "${local_needed[@]}" | hash_paths "$manifest_type" "$dir")
    fi

    # The mtime fallback, for deciding sides still without a hash: a clean
    # hash-backed unit needs neither a local walk nor a cloud listing.
    local local_fallback=0 remote_fallback=0
    for path in ${local_deciding[@]+"${local_deciding[@]}"}; do
        [ -n "${local_hash[$path]:-}" ] || local_fallback=1
    done
    for path in ${remote_deciding[@]+"${remote_deciding[@]}"}; do
        [ -n "${remote_hash[$path]:-}" ] || remote_fallback=1
    done
    if [ "$local_fallback" = 1 ]; then
        while IFS= read -r path; do local_moved[$path]=1; done < <(
            find "$dir" "${UNIT_PRUNE[@]}" -type f -newer "$baseline" -printf '%P\n')
    fi
    if [ "$remote_fallback" = 1 ]; then
        # Only the flagged files are consulted, so only they are kept. Times
        # compare as strings: 'max' is "Y-m-d H:M:S.ns" with trailing fraction
        # zeros trimmed, which keeps lexicographic order chronological against
        # the full-precision cutoff.
        local cutoff listing
        cutoff=$(TZ=UTC date '+%Y-%m-%d %H:%M:%S.%N' -r "$baseline")
        listing=$(remote_listing "$remote_path") || return 1
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            path=${line#*;}
            [ -n "${flagged[$path]:-}" ] || continue
            [[ ${line%%;*} > $cutoff ]] && remote_moved[$path]=1
        done <<<"$listing"
    fi

    for index in "${!paths[@]}"; do
        flag=${flags[$index]} path=${paths[$index]} shape=edit ancestor_hash=${ancestor[$path]:-}
        local_changed=0; side_changed "${local_hash[$path]:-}" "$ancestor_hash" "${local_moved[$path]:-}" && local_changed=1
        remote_changed=0; side_changed "${remote_hash[$path]:-}" "$ancestor_hash" "${remote_moved[$path]:-}" && remote_changed=1
        case "$flag" in
            '*') case "$local_changed$remote_changed" in
                     10) class=local ;; 01) class=remote ;; *) class=both ;;    # 00: unattributable
                 esac ;;
            '+') shape=delete
                 if [ -z "${synced[$path]:-}" ]; then class=local shape=add      # not shared last sync
                 elif [ "$local_changed" = 1 ]; then class=both               # edited here, dropped there
                 else class=remote; fi ;;                                     # the cloud dropped it
            '-') shape=delete
                 if [ -z "${synced[$path]:-}" ]; then class=remote shape=add     # never here: it arrived there
                 elif [ "$remote_changed" = 1 ]; then class=both              # deleted here, changed there
                 else class=local; fi ;;                                      # deleted here
            '!') class=both ;;
        esac
        printf '%s %s %s\n' "$class" "$shape" "$path"
    done
}

# Fold classification lines (stdin) into the two drift bits, "<up><down>".
drift_bits() {
    local up=0 down=0 class
    while read -r class _; do
        case "$class" in
            local)  up=1 ;;
            remote) down=1 ;;
            both)   up=1; down=1 ;;
        esac
    done
    printf '%s%s' "$up" "$down"
}

# Render drift bits as the symbol the user reads:
#   =  in sync    >  local ahead    <  cloud ahead    <>  diverged (both changed)
drift_symbol() {
    case "$1" in 00) printf '=' ;; 10) printf '>' ;; 01) printf '<' ;; 11) printf '<>' ;; esac
}

# Split one classification line into the caller's class / shape / path — the
# only parser of classify_unit's output grammar. Split by hand rather than by
# `read` word-splitting, which eats leading spaces in the path.
drift_fields() {
    class=${1%% *}; local rest=${1#* }
    shape=${rest%% *}; path=${rest#* }
}

# Render a classification block: one indented "<class> <shape> <path>" per
# line, sorted.
print_drift_files() {
    local line class shape path
    while IFS= read -r line; do
        drift_fields "$line"
        printf '    %-6s %-6s %s\n' "$class" "$shape" "$path"
    done < <(sort <<<"$1")
}

# Set DRIFT (and DRIFT_FILES where a full comparison ran) for a unit, and refresh
# the prompt's cloud bit. Globals rather than output: cmd_status and the transfer
# guard need both halves, and a command substitution would lose the second.
# DRIFT is '?' when the cloud could not be read — never a confident symbol.
probe_unit() {
    local dir=$1 remote_path state_dir baseline bits reachable=0
    remote_path=$(remote_of "$dir"); state_dir=$(state_path "$(spec_of "$dir")"); baseline=$state_dir/$BASELINE
    DRIFT_FILES=''

    step 'comparing with the cloud'
    remote_presence "$remote_path" || reachable=$?
    if [ "$reachable" = 2 ]; then
        DRIFT='?' DRIFT_BASIS=unreadable; return 0    # see the '?' note below
    elif [ "$reachable" = 1 ]; then
        # Nothing on the cloud (never pushed, or an empty unit on an object store
        # that cannot hold empty dirs): local content is unpushed, empty is in sync.
        DRIFT_BASIS=absent
        if has_local_content "$dir"; then bits=10; else bits=00; fi
    elif [ -d "$dir" ] && [ -e "$baseline" ] && [ -e "$state_dir/$MANIFEST" ]; then
        if DRIFT_FILES=$(classify_unit "$dir" "$remote_path" "$state_dir"); then
            DRIFT_BASIS=compared
            bits=$(drift_bits <<<"$DRIFT_FILES")
        else
            # The cloud could not be read. Claiming '=' here would be a lie the
            # prompt then repeats, so report '?' and leave the stored bit — and
            # its age, which drives the prompt's staleness marker — untouched.
            DRIFT_FILES='' DRIFT='?' DRIFT_BASIS=unreadable; return 0
        fi
    else
        # No baseline: with local content, direction is unknowable; without,
        # there is nothing local to lose — a pull is a pure fetch.
        DRIFT_BASIS=unbaselined
        if has_local_content "$dir"; then bits=11; else bits=01; fi
    fi
    DRIFT=$(drift_symbol "$bits")

    # Keep the prompt's cloud bit fresh. It stores 'diverged' rather than folding
    # it into 'behind' so the conservative half of a '<>' survives: the prompt's
    # own local check is mtime-only and cannot see a same-mtime conflict.
    mkdir -p "$state_dir"
    case "$bits" in
        11) record_remote_bit "$state_dir" diverged ;;
        01) record_remote_bit "$state_dir" behind ;;
        *)  record_remote_bit "$state_dir" sync ;;
    esac
}

# Move bytes src -> dst, excluding git internals and markers. MIRROR=1
# propagates deletions (rclone sync); otherwise additive (rclone copy).
#
# Whole tree: the unit's exclusions, plus --checksum when the remote has
# hashes — the default size+modtime skip could leave a same-size edit behind
# while its hash is recorded as shared. A path list ($3, newline-separated):
# every listed file is known to differ, so --ignore-times forces the copy.
# rclone takes no other filter beside --files-from-raw ('raw': the plain form
# reads '#'/';' names as comments); the lists come from a classification that
# already applied the exclusions.
#
# Progress: live on a terminal, else a one-line NOTICE summary every 10s. The
# direction is read off src: remote paths always start with $BASE. See
# ARCHITECTURE.md, "Sync model".
transfer() {
    local src=$1 dst=$2 files=${3:-} verb=copy way=uploading count=''
    [ "$MIRROR" = 1 ] && verb=sync
    case $src in "$BASE"*) way=downloading ;; esac
    [ -z "$files" ] || count=" $(grep -c '' <<<"$files") file(s)"
    step "$way$count"
    local -a progress=(--progress)
    [ -t 2 ] || progress=(--stats 10s --stats-one-line --stats-log-level NOTICE)
    if [ -n "$files" ]; then
        # Fed on stdin: rclone re-reads the filter file while initialising, so
        # a process-substitution path would already be gone.
        printf '%s\n' "$files" | run_rclone "$verb" --files-from-raw - \
            --ignore-times "${progress[@]}" "$src" "$dst"
    else
        local -a flags=()
        remote_hash_type || return 1
        [ -z "$HASH_TYPE" ] || flags+=(--checksum)
        run_rclone "$verb" ${flags[@]+"${flags[@]}"} "${UNIT_EXCLUDE[@]}" \
            "${progress[@]}" "$src" "$dst"
    fi
}

# --- git history sidecar (carried from prj) ---------------------------------
# Reattach git history from history.bundle to a freshly pulled tree, without
# overwriting files. Only when a bundle exists and .git does not.
# A failure only warns: the files have crossed and the sync point must still be
# recorded. The half-built .git is removed, so the next pull retries.
restore_git() {
    local dir=$1 bundle="$1/history.bundle"
    [ -f "$bundle" ] || return 0
    [ ! -e "$dir/.git" ] || return 0   # a directory, or a worktree/submodule link

    info 'restoring git history from history.bundle'
    if ! attach_bundle "$dir" "$bundle"; then
        rm -rf "$dir/.git"
        warn 'could not restore git history from %s; the next pull retries' "$bundle"
    fi
}

# Init a repository in <dir> from <bundle> and check out its main branch (else
# its first) without touching the work tree. Every step is checked by hand: a
# caller's `if` turns errexit off in here.
attach_bundle() {   # <dir> <bundle>
    local dir=$1 bundle=$2 branches branch
    git -C "$dir" init -q || return 1
    git -C "$dir" symbolic-ref HEAD refs/heads/__ferry_restore__ || return 1
    git -C "$dir" fetch -q "$bundle" 'refs/heads/*:refs/heads/*' 'refs/tags/*:refs/tags/*' || return 1
    branches=$(git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads/) || return 1
    branch=$(grep -Ex 'main|master' <<<"$branches" | head -1 || true)
    [ -n "$branch" ] || branch=$(head -1 <<<"$branches")
    [ -n "$branch" ] || { warn 'bundle has no branches'; return 1; }
    git -C "$dir" symbolic-ref HEAD "refs/heads/$branch" || return 1
    git -C "$dir" reset -q
}

# Snapshot git history into a single file the next push carries up. A failed
# bundle fails the caller: pushing on would carry a stale history as current.
#
# git writes the bundle atomically itself (through history.bundle.lock). A
# lock an interrupted run left behind is removed first — before any early
# return, since every upload bundles before it transfers — or it would block
# each later bundle and ride up as content.
bundle_git() {
    local dir=$1 refs
    rm -f "$dir/history.bundle.lock"
    [ -d "$dir/.git" ] || return 0
    # No commits yet: nothing to carry, and git refuses an empty bundle.
    refs=$(git -C "$dir" for-each-ref --count=1) || return 1
    [ -n "$refs" ] || return 0

    info 'bundling git history'
    if ! git -C "$dir" bundle create "$dir/history.bundle" --all; then
        warn 'could not bundle the git history of %s' "$dir"
        return 1
    fi

    if [ -f "$dir/.gitignore" ] && ! grep -qxF 'history.bundle' "$dir/.gitignore"; then
        printf 'history.bundle\n' >> "$dir/.gitignore"
        info 'added history.bundle to .gitignore'
    fi
}

# Refuse a transfer that would destroy what the other side changed since the
# last sync, git's non-fast-forward refusal. A plain copy only overwrites files
# on both sides, so only a far-side `edit` blocks it; --mirror also deletes, so
# every far-side change blocks it. Costs one probe, which --force skips with the
# block. See ARCHITECTURE.md, "Transfer guard".
guard_transfer() {
    local verb=$1 dir=$2 reason='' line class shape path
    [ "$FORCE" = 1 ] && return 0
    probe_unit "$dir"

    case "$DRIFT_BASIS:$DRIFT" in
        unreadable:*)     reason='unknown: the cloud could not be read' ;;
        unbaselined:'<>') reason='diverged: never synced from this machine, so neither side is known to be newer' ;;
    esac

    # The far side is the one this transfer writes over.
    local far=remote; [ "$verb" = pull ] && far=local
    local -a blocking=(); local saw_both=0
    if [ -z "$reason" ]; then
        while IFS= read -r line; do
            drift_fields "$line"
            case "$class" in "$far"|both) ;; *) continue ;; esac
            if [ "$MIRROR" = 1 ] || [ "$shape" = edit ]; then
                blocking+=("$path")
                [ "$class" = both ] && saw_both=1
            fi
        done <<<"$DRIFT_FILES"
        if [ ${#blocking[@]} -gt 0 ]; then
            if [ "$saw_both" = 1 ]; then reason='diverged: both sides changed since the last sync'
            elif [ "$MIRROR" = 1 ]; then reason="--mirror would delete or overwrite changes on the $far side"
            elif [ "$verb" = push ]; then reason='the cloud has edits this push would overwrite'
            else reason='you have edits this pull would overwrite'; fi
        fi
    fi
    [ -n "$reason" ] || return 0

    warn 'refusing to %s %s — %s' "$verb" "$(spec_of "$dir")" "$reason"
    [ ${#blocking[@]} -eq 0 ] || printf '    %s\n' "${blocking[@]}" >&2
    if [ "$DRIFT_BASIS" = unreadable ]; then
        warn 'retry when the cloud is reachable, or override with --force'
    else
        warn "inspect it with '%s resolve', or override with --force" "$PROG"
    fi
    return 1
}

# --- per-unit operations ----------------------------------------------------
# Each returns non-zero (rather than dying) so a walk can tally and carry on.
pull_unit() {
    local dir=$1
    load_ignore "$dir" "$(remote_of "$dir")" || return 1
    guard_transfer pull "$dir" || return 1
    fetch_unit "$dir"
}

# The transfer half of a pull, once the guard has passed and the cloud's rules
# are loaded.
fetch_unit() {
    local dir=$1 remote_path manifest; remote_path=$(remote_of "$dir")
    # An additive pull leaves cloud ⊆ local, so the cloud's list — hashes
    # included — is the set the two sides will share. A listing that fails must
    # fail the transfer, not quietly record an empty ancestor set.
    remote_hash_type || return 1
    manifest=$(list_side remote "$remote_path") || return 1
    mkdir -p "$dir" || return 1
    transfer "$remote_path" "$dir" || return 1
    claim_unit "$dir" || return 1
    restore_git "$dir"
    mark_synced "$(spec_of "$dir")" "$(format_manifest "$HASH_TYPE" "$manifest")"
}

push_unit() {
    local dir=$1
    load_ignore "$dir"
    [ -d "$dir" ] || { warn 'no local dir %s' "$dir"; return 1; }
    guard_transfer push "$dir" || return 1
    bundle_git "$dir" || return 1          # before the snapshot: the bundle is content
    send_unit "$dir"
}

# The transfer half of a push, once the guard has passed and the bundle is fresh.
send_unit() {
    local dir=$1 remote_path paths; remote_path=$(remote_of "$dir")
    # An additive push leaves local ⊆ cloud, so the local list is the shared
    # set: its paths captured BEFORE the transfer, their hashes read AFTER —
    # exactly record_sync_point's recipe.
    paths=$(list_side local "$dir") || return 1
    transfer "$dir" "$remote_path" || return 1
    claim_unit "$dir" || return 1
    record_sync_point "$remote_path" "$(spec_of "$dir")" "$paths"
}

# Record the post-sync ancestors: the remote listing intersected with the
# paths the caller captured before its transfer (so a file that arrived during
# the sync never enrols), under a fresh baseline. An empty path list skips the
# listing: nothing is shared, and there may be no remote prefix to list.
# Still-conflicted paths keep their previous ancestor line, so they keep
# reading `both` and the prompt bit stays 'diverged'.
record_sync_point() {   # <remote> <spec> <shared paths> [<conflicted path>...]
    local remote_path=$1 spec=$2 shared=$3; shift 3
    remote_hash_type || return 1
    local body='' line path
    if [ -n "$shared" ]; then
        body=$(list_side remote "$remote_path") || return 1
        body=$(intersect_manifest "$shared" "$body")
    fi
    if [ $# -gt 0 ]; then
        local -A synced=() ancestor=() conflicted=(); local manifest_type out=''
        read_manifest "$(state_path "$spec")/$MANIFEST" manifest_type synced ancestor
        for path in "$@"; do conflicted[$path]=1; done
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            [ -n "${conflicted[${line#* }]:-}" ] || out+=$line$'\n'
        done <<<"$body"
        for path in "$@"; do out+="${ancestor[$path]:-} $path"$'\n'; done
        body=${out%$'\n'}
    fi
    local bit=sync; [ $# -eq 0 ] || bit=diverged
    mark_synced "$spec" "$(format_manifest "$HASH_TYPE" "$body")" "$bit"
}

# Converge a unit with the cloud: carry each side's changes to the other in
# one run — additive both ways, toward the union (a deletion on one side is
# restored from the other; propagating deletions stays with push/pull
# --mirror). A file changed on BOTH sides moves in neither direction: sync
# converges everything safe and leaves each conflict in place for `resolve`.
sync_unit() {
    local dir=$1 remote_path spec; remote_path=$(remote_of "$dir"); spec=$(spec_of "$dir")
    load_ignore "$dir"
    bundle_git "$dir" || return 1   # before the probe: the bundle is content to classify
    probe_unit "$dir"

    case "$DRIFT_BASIS:$DRIFT" in
        unreadable:*) warn 'cannot read the cloud for %s' "$spec"; return 1 ;;
        *:'=') # Content agrees, but the ancestors may not: a conflict reconciled
             # by hand leaves the manifest holding versions neither side has,
             # and the next edit would read 'both' against them. So re-record
             # unconditionally — the stored prompt bit cannot stand in for
             # "manifest is current", since any `status` over agreeing content
             # writes 'sync' regardless of what the manifest holds.
             local shared; shared=$(list_side local "$dir") || return 1
             record_sync_point "$remote_path" "$spec" "$shared" || return 1
             info '%s in sync' "$spec"
             return 0 ;;
    esac
    # Without a comparison there is one safe direction, or none. The probe
    # above stands in for the guard, and the bundle is already fresh.
    case "$DRIFT_BASIS:$DRIFT" in
        absent:*)         send_unit "$dir"; return ;;     # no cloud prefix yet: a first push
        unbaselined:'<')  load_ignore "$dir" "$remote_path" || return 1
                          fetch_unit "$dir"; return ;;    # nothing local to lose: a plain pull
        unbaselined:*)    warn '%s has never been synced from this machine; choose a side' "$spec"
                          warn "with '%s push --force' or '%s pull --force'" "$PROG" "$PROG"
                          return 1 ;;
    esac

    local line class shape path
    local -a up=() down=() conflicts=()
    while IFS= read -r line; do
        drift_fields "$line"
        case "$class:$shape" in
            local:delete)  down+=("$path") ;;  # deleted here — the union restores it
            local:*)       up+=("$path") ;;    # edited/added here — carry it up
            remote:delete) up+=("$path") ;;    # dropped there — restore it
            remote:*)      down+=("$path") ;;  # edited/added there — bring it down
            *)             conflicts+=("$path") ;;  # 'both': neither direction is safe
        esac
    done <<<"$DRIFT_FILES"

    local shared; shared=$(list_side local "$dir") || return 1
    if [ ${#down[@]} -gt 0 ]; then
        transfer "$remote_path" "$dir" "$(printf '%s\n' "${down[@]}")" || return 1
        shared+=$'\n'$(printf '%s\n' "${down[@]}")
    fi
    if [ ${#up[@]} -gt 0 ]; then
        transfer "$dir" "$remote_path" "$(printf '%s\n' "${up[@]}")" || return 1
    fi
    claim_unit "$dir" || return 1
    restore_git "$dir"
    record_sync_point "$remote_path" "$spec" "$shared" ${conflicts[@]+"${conflicts[@]}"} || return 1

    info '%s: %d up, %d down' "$spec" "${#up[@]}" "${#down[@]}"
    if [ ${#conflicts[@]} -gt 0 ]; then
        warn '%d conflicted, untouched on both sides:' "${#conflicts[@]}"
        printf '%s\n' "${conflicts[@]}" | sort | sed 's/^/    /' >&2
        warn "inspect with '%s resolve %s'" "$PROG" "$spec"
        return 1
    fi
}

# Apply a per-unit op (pull_unit|push_unit|sync_unit) across units, continuing
# past failures and printing a tally. Returns non-zero if any failed.
#
# Each unit runs in a subshell with errexit live. Calling the op as an `if`
# condition would switch errexit off for its whole body, so a failure the code
# does not check by hand would pass as success; here it fails the unit, and so
# does a `die` — never the rest of the batch. The subshell also forgets what a
# unit memoized, which is why run_units settles the hash type before a batch.
run_batch() {
    local op=$1; shift
    local n=$# i=0 ok=0 dir spec status; local -a failed=()
    for dir in "$@"; do
        i=$((i + 1))
        spec=$(spec_of "$dir")
        info '[%d/%d] %s %s' "$i" "$n" "${op%_unit}" "$spec"
        set +e; ( set -e; "$op" "$dir" ); status=$?; set -e
        if [ "$status" = 0 ]; then ok=$((ok + 1))
        else failed+=("$dir"); warn 'FAILED %s' "$spec"; fi
    done
    if [ ${#failed[@]} -gt 0 ]; then
        local -a failed_specs=()
        for dir in "${failed[@]}"; do failed_specs+=("$(spec_of "$dir")"); done
        warn '%d/%d ok, %d failed: %s' "$ok" "$n" "${#failed[@]}" "${failed_specs[*]}"
        return 1
    fi
    info '%d/%d ok' "$ok" "$n"
}

# Run a per-unit op on the unit <dir> names (as <resolver> finds it), or else
# on every unit under $PWD. A walk never mirrors: deletion-propagation is a
# single-unit-only opt-in.
#
# Every phase is announced (see STEPS), and the hash type — fixed for the run —
# is probed once here, before run_batch's per-unit subshells would each forget
# it; a dead cloud fails fast.
run_units() {   # <op> <resolver> [<dir>]
    local op=$1 resolver=$2 target here; local -a units
    if [ -n "${3:-}" ]; then
        target=$("$resolver" "$3"); units=("$target")
    else
        [ "$MIRROR" = 0 ] || die "--mirror applies to a single <dir> only"
        here=$(pwd -P); mapfile -t units < <(units_under "$here")
        [ ${#units[@]} -gt 0 ] || { info 'no units under %s' "$here"; return 0; }
    fi
    STEPS=1
    remote_hash_type || die "cannot read the cloud at $BASE"
    run_batch "$op" "${units[@]}"
}

# Resolve a verb's target to the unit it acts on: the argument if given, else the
# unit enclosing $PWD. Dies if neither yields a unit.
unit_target() {
    local target
    if [ -n "${1:-}" ]; then target=$(resolve_target "$1")
    else target=$(enclosing_unit "$(pwd -P)") || die "not inside a unit; pass <dir>"; fi
    is_unit "$target" || die "not a unit: $(spec_of "$target")"
    printf '%s' "$target"
}

# --- verbs ------------------------------------------------------------------
cmd_init() {
    local base=$1
    is_remote_base "$base" || die "base must look like 'remote:path', got '$base'"
    locate_tree && die "already inside a tree rooted at $ROOT"
    [ -e "$PWD/$MARKER" ] && die "$MARKER already exists here"
    printf '%s\n' "$base" > "$PWD/$MARKER"
    info 'initialized root at %s -> %s' "$(pwd -P)" "$base"
}

cmd_list() {
    local target; target=$(resolve_target "${1:-}")
    run_rclone lsf --dirs-only --format "tp" --separator '  ' "$(remote_of "$target")" | sort -k3
}

# Drift for every unit at/under the target (or $PWD): one symbol+spec row each.
# For a single unit, also the per-file classification behind its symbol.
cmd_status() {
    local target; target=$(resolve_target "${1:-}")
    local -a units; mapfile -t units < <(units_under "$target")
    [ ${#units[@]} -gt 0 ] || die "no units under $(spec_of "$target")"

    local unit
    for unit in "${units[@]}"; do
        probe_unit "$unit"
        printf '%-3s %s\n' "$DRIFT" "$(spec_of "$unit")"
    done

    # A single unit leaves its own detail in DRIFT_FILES.
    if [ ${#units[@]} -eq 1 ] && [ -n "$DRIFT_FILES" ]; then
        print_drift_files "$DRIFT_FILES"
    fi
}

# Stage the cloud side of a conflict in the unit's state dir, to compare with
# ordinary tools; ferry does not merge. Outside the tree, so it never rides up,
# and drop/rm take it away with the unit. See ARCHITECTURE.md, "Resolving".
cmd_resolve() {
    STEPS=1
    local target; target=$(unit_target "${1:-}")
    local spec remote_path stage line; spec=$(spec_of "$target"); remote_path=$(remote_of "$target")
    stage=$(state_path "$spec")/conflict
    probe_unit "$target"

    case "$DRIFT_BASIS:$DRIFT" in
        unreadable:*) die "cannot read the cloud for $spec — nothing to compare against" ;;
        *:'<>') ;;
        *)      rm -rf "$stage"
                info 'no conflict in %s (%s)' "$spec" "$DRIFT"; return 0 ;;
    esac

    # Never synced from here: nothing has been reconciled, so there is no
    # conflicting subset to single out.
    if [ "$DRIFT_BASIS" = unbaselined ]; then
        rm -rf "$stage"
        info '%s has never been synced from this machine, so both sides are' "$spec"
        printf '  unreconciled in full. Compare with '\''rclone ls %s'\'', then push or pull\n' "$remote_path"
        printf '  with --force to choose a side.\n'
        return 0
    fi

    # Everything the cloud touched — the versions you cannot see from here. Files
    # only you changed need no staging: your copy is already the one in hand.
    local -a wanted=(); local -A label=(); local class shape path
    while IFS= read -r line; do
        drift_fields "$line"
        # A file the cloud deleted has no version to stage; the rest do.
        case "$class:$shape" in
            *:delete)    continue ;;
            both:*)      label[$path]='changed on both sides' ;;
            remote:add)  label[$path]='added on the cloud' ;;
            remote:edit) label[$path]='edited on the cloud' ;;
            *)           continue ;;
        esac
        wanted+=("$path")
    done <<<"$DRIFT_FILES"
    if [ ${#wanted[@]} -eq 0 ]; then
        rm -rf "$stage"
        info 'nothing of the cloud'\''s to stage for %s — it differs by deletions' "$spec"
        printf '  and changes of your own:\n'
        print_drift_files "$DRIFT_FILES"
        info "'%s push' keeps your side, '%s pull --mirror' accepts the deletions" "$PROG" "$PROG"
        return 0
    fi

    # Build beside the previous staging and swap, so a failed copy never leaves
    # the user with neither. --files-from-raw because plain --files-from reads a
    # leading '#' or ';' as a comment and trims surrounding whitespace — it would
    # silently skip legitimate filenames.
    rm -rf "$stage.new"; mkdir -p "$stage.new"
    step "staging ${#wanted[@]} cloud file(s)"
    printf '%s\n' "${wanted[@]}" | run_rclone copy --files-from-raw - "$remote_path" "$stage.new" \
        || die "could not stage the cloud version of $spec"

    # rclone reports "nothing to transfer" as success, so a path the cloud turns
    # out not to hold (one attributed to a cloud-side deletion) would otherwise be
    # announced as staged. Trust the staging dir, not the exit status.
    local -a staged=() absent=()
    for path in "${wanted[@]}"; do
        if [ -e "$stage.new/$path" ]; then staged+=("$path"); else absent+=("$path"); fi
    done
    if [ ${#staged[@]} -eq 0 ]; then
        rm -rf "$stage.new" "$stage"
        info 'the cloud no longer holds %s — deleted there, not edited' "${absent[*]}"
        info "'%s push --force' restores it, '%s pull --mirror' accepts the deletion" "$PROG" "$PROG"
        return 0
    fi
    rm -rf "$stage"; mv "$stage.new" "$stage"

    info 'the cloud version of %d file(s) is in\n  %s' "${#staged[@]}" "$stage"
    for path in "${staged[@]}"; do printf '    %s   (%s)\n' "$path" "${label[$path]}"; done
    [ ${#absent[@]} -eq 0 ] || info 'deleted on the cloud, nothing to stage: %s' "${absent[*]}"
    if [ -d "$target/.git" ] && [ -e "$stage/history.bundle" ]; then
        info 'the histories share a merge base, so'
        printf '  git -C %s fetch %s/history.bundle "refs/heads/*:refs/remotes/ferry/*"\n' "$target" "$stage"
        printf '  gives you the other side as branches to merge.\n'
    fi
    # Not a plain push: a merged file matches neither side, so the guard still
    # sees a conflict. Forcing is the point — you have now looked at both.
    info "reconcile in place, then '%s push --force' to publish your result" "$PROG"
}

# Create a brand-new unit locally; the cloud prefix materializes on first push.
# The named target becomes a unit at birth (empty marker); parent dirs are created
# markerless by mkdir -p. We do not pre-create the cloud folder: an empty dir is
# unrepresentable on object stores, and a never-pushed unit reads correctly anyway
# (status: '=' empty, '>' once it holds files). Refused if the cloud path exists.
cmd_new() {
    local target; target=$(resolve_target "$1")
    refuse_in_unit "$target"
    [ -e "$target" ] && die "already exists: $target"
    local presence=0; remote_presence "$(remote_of "$target")" || presence=$?
    [ "$presence" = 2 ] && die "cannot reach the cloud to check $(remote_of "$target")"
    [ "$presence" = 0 ] && die "already on cloud: $(remote_of "$target") (use 'pull' to fetch it)"
    mkdir -p "$target"
    claim_unit "$target"
    mark_synced "$(spec_of "$target")" ''
    info 'created unit %s (push to materialize on the cloud)' "$(spec_of "$target")"
}

# The daily verb: direction comes from the classification, not from the user.
cmd_sync() { run_units sync_unit unit_target "${1:-}"; }
cmd_pull() { run_units pull_unit transfer_target "${1:-}"; }
cmd_push() { run_units push_unit push_target "${1:-}"; }

# A push's unit must exist here: checked before anything reaches the cloud.
push_target() {
    local target; target=$(transfer_target "$1")
    [ -d "$target" ] || die "no local dir: $(spec_of "$target")"
    printf '%s' "$target"
}

cmd_drop() {
    local target; target=$(unit_target "${1:-}")
    refuse_cwd_inside "$target"
    local spec; spec=$(spec_of "$target")
    probe_unit "$target"        # the same classifier status uses: direction matters here
    case "$DRIFT_BASIS:$DRIFT" in
        unreadable:*) warn 'WARNING — could not read the cloud to check for unpushed changes.' ;;
        *:*'>'*)      warn 'WARNING — local has changes not on the cloud (unpushed).' ;;
    esac
    confirm "Delete local $target? (cloud keeps its copy)"
    rm -rf "$target"
    rm -rf "$(state_path "$spec")"
    info 'dropped %s (cloud retains it)' "$spec"
}

# Delete a unit on BOTH sides. Restricted to a local unit: cloud-only paths are
# out of scope (use rclone directly), and a grouping dir is never purged wholesale.
cmd_rm() {
    local target; target=$(unit_target "$1")
    refuse_cwd_inside "$target"
    local remote_path spec presence=0; remote_path=$(remote_of "$target"); spec=$(spec_of "$target")
    remote_presence "$remote_path" || presence=$?
    # Deleting only the local copy while reporting "both sides" would be a lie
    # that also loses the one copy we could still see.
    [ "$presence" = 2 ] && die "cannot reach the cloud for $spec — refusing to delete the local copy alone"
    confirm "DELETE BOTH local and cloud for '$spec'? (recovery depends on the remote's trash/versioning)"
    [ "$presence" != 0 ] || run_rclone purge "$remote_path"
    rm -rf "$target"
    rm -rf "$(state_path "$spec")"
    info 'removed %s from both sides' "$spec"
}

# Rename/move a unit or grouping dir. Cloud is authoritative: move there first, then
# realign local and carry the sync-state subtree. Names mirror remote, so every
# descendant's derived remote follows the move for free.
#
# The destination must be free on BOTH sides: `rclone moveto` onto an existing
# cloud directory merges into it, overwriting same-named files. A source the
# cloud does not hold (a unit never pushed) moves locally only.
cmd_mv() {
    local old=$1 new=$2
    local old_abs new_abs; old_abs=$(resolve_target "$old"); new_abs=$(resolve_target "$new")
    local old_spec new_spec; old_spec=$(spec_of "$old_abs"); new_spec=$(spec_of "$new_abs")
    [ "$old_abs" != "$ROOT" ] || die "the tree root cannot be moved"
    case "$new_abs/" in "$old_abs/"*) die "cannot move $old_spec into itself" ;; esac
    refuse_cwd_inside "$old_abs"
    refuse_in_unit "$old_abs"
    refuse_in_unit "$new_abs"
    [ ! -e "$new_abs" ] || die "local target exists: $new_abs"

    local old_remote_path new_remote_path old_presence=0 new_presence=0
    old_remote_path=$(remote_of "$old_abs"); new_remote_path=$(remote_of "$new_abs")
    remote_presence "$new_remote_path" || new_presence=$?
    [ "$new_presence" != 2 ] || die "cannot read the cloud to check $new_spec"
    [ "$new_presence" = 1 ] || die "cloud target exists: $new_remote_path"
    remote_presence "$old_remote_path" || old_presence=$?
    [ "$old_presence" != 2 ] || die "cannot read the cloud to check $old_spec"
    [ "$old_presence" = 0 ] || [ -e "$old_abs" ] || die "no such unit or directory: $old_spec"
    # 'Absent' may also mean 'behind an unreadable parent'. Once a unit has
    # shared files with the cloud, a local-only move would orphan its copy.
    if [ "$old_presence" = 1 ] && has_shared_files "$old_spec"; then
        die "the cloud no longer answers for $old_spec, which it held at the last sync; refusing a local-only move"
    fi

    if [ "$old_presence" = 0 ]; then
        run_rclone moveto "$old_remote_path" "$new_remote_path"
        info 'moved on cloud %s -> %s' "$old_spec" "$new_spec"
    fi

    if [ -e "$old_abs" ]; then
        mkdir -p "$(dirname "$new_abs")"
        mv "$old_abs" "$new_abs"
        info 'renamed local %s -> %s' "$old_spec" "$new_spec"
    fi

    local old_state_dir new_state_dir
    old_state_dir=$(state_path "$old_spec"); new_state_dir=$(state_path "$new_spec")
    if [ -d "$old_state_dir" ]; then
        rm -rf "$new_state_dir"
        mkdir -p "$(dirname "$new_state_dir")"
        mv "$old_state_dir" "$new_state_dir"
    fi
}

# Split a VERBS entry into the caller's verb_name / verb_spec / verb_summary.
split_verb() {
    local head=${1%% — *}
    verb_summary=${1#* — }
    verb_name=${head%% *}
    verb_spec=${head#"$verb_name"}; verb_spec=${verb_spec# }
}

# Read a VERBS argument spec into the caller's spec_min / spec_max (how many
# positional arguments), spec_flags (flags beyond COMMON_FLAGS, space-separated)
# and spec_complete (what a positional completes to: 'dir', literal words, or
# nothing). An argument `<x>` is a local path unless its name holds ':'.
parse_spec() {
    local word; local -a words
    spec_min=0 spec_max=0 spec_flags='' spec_complete=''
    read -ra words <<<"$1"
    for word in ${words[@]+"${words[@]}"}; do
        case $word in
            '[-'*) word=${word#[}; word=${word%]}
                   spec_flags+="${spec_flags:+ }${word//|/ }"; continue ;;
            '['*)  spec_max=$((spec_max + 1)) ;;
            *)     spec_min=$((spec_min + 1)) spec_max=$((spec_max + 1)) ;;
        esac
        word=${word#[}; word=${word%]}
        case $word in
            '<'*:*'>') ;;
            '<'*)      spec_complete=dir ;;
            *)         spec_complete+="${spec_complete:+ }$word" ;;
        esac
    done
}

# Die unless <verb> is in VERBS and takes these flags and this many positional
# arguments, as its entry spells them.
check_invocation() {   # <verb> <positional count> [<flag>...]
    local verb=$1 count=$2 entry flag usage accepted
    local verb_name='' verb_spec verb_summary spec_min spec_max spec_flags spec_complete
    shift 2
    for entry in "${VERBS[@]}"; do
        split_verb "$entry"
        [ "$verb_name" != "$verb" ] || break
    done
    [ "$verb_name" = "$verb" ] || die "unknown command: $verb (try: $PROG help)"
    parse_spec "$verb_spec"
    usage="usage: $PROG $verb${verb_spec:+ $verb_spec}"
    accepted=" $COMMON_FLAGS $spec_flags "
    for flag in "$@"; do
        [[ $accepted == *" $flag "* ]] || die "$verb does not take $flag ($usage)"
    done
    [ "$count" -ge "$spec_min" ] && [ "$count" -le "$spec_max" ] || die "$usage"
}

# Emit a bash completion script for ferry; install with `eval "$(ferry completion bash)"`.
# Only bash is supported. The prompt indicator stays a separately-sourced file
# (ferry-prompt.sh), like git's git-prompt.sh vs git-completion.bash. Verbs and
# their arguments come from VERBS, so completion offers what main accepts.
cmd_completion() {
    [ "$1" = bash ] || die "unsupported shell '$1' (only bash)"
    local entry verbs='' verb_name verb_spec verb_summary spec_min spec_max spec_flags spec_complete
    printf '# bash completion for ferry — verbs, verb-specific flags, directory arguments.\n'
    printf '# Plain bash 3.2: no associative arrays, no mapfile.\n'
    printf '# shellcheck disable=SC2207\n'
    # _ferry_of <flags|args> <verb>: a verb's flags, or what its positional
    # arguments complete to ('dir', literal words, or nothing).
    # shellcheck disable=SC2016
    printf '_ferry_of() {\n    case $1:$2 in\n'
    for entry in "${VERBS[@]}"; do
        split_verb "$entry"
        parse_spec "$verb_spec"
        verbs+=" $verb_name"
        printf '        flags:%s) printf %%s %q ;;\n' "$verb_name" "$COMMON_FLAGS${spec_flags:+ $spec_flags}"
        printf '        args:%s) printf %%s %q ;;\n' "$verb_name" "$spec_complete"
    done
    printf '        flags:*) printf %%s %q ;;\n' "$COMMON_FLAGS"
    printf '    esac\n}\n'
    printf '_ferry_verbs=%q\n' "${verbs# }"
    cat <<'COMPLETION'
_ferry() {
    local cur=${COMP_WORDS[COMP_CWORD]} verb='' word i only_words=0
    # The verb is the first word that is not a flag, as main reads it; a `--`
    # anywhere before the cursor makes the rest words.
    for (( i = 1; i < COMP_CWORD; i++ )); do
        word=${COMP_WORDS[i]}
        if [ "$only_words" = 0 ] && [ "$word" = -- ]; then only_words=1
        elif [ -z "$verb" ] && { [ "$only_words" = 1 ] || [ "${word:0:1}" != - ]; }; then verb=$word
        fi
    done
    COMPREPLY=()
    if [ "$only_words" = 0 ] && [ "${cur:0:1}" = - ]; then
        COMPREPLY=( $(compgen -W "$(_ferry_of flags "$verb")" -- "$cur") )
    elif [ -z "$verb" ]; then
        COMPREPLY=( $(compgen -W "$_ferry_verbs" -- "$cur") )
    else
        case $(_ferry_of args "$verb") in
            '')  ;;
            dir) if declare -F _filedir >/dev/null 2>&1; then _filedir -d
                 else COMPREPLY=( $(compgen -d -- "$cur") ); fi ;;
            *)   COMPREPLY=( $(compgen -W "$(_ferry_of args "$verb")" -- "$cur") ) ;;
        esac
    fi
}
complete -F _ferry ferry
COMPLETION
}

cmd_help() { usage 0; }

# Print the header comment's prose and the VERBS table, then exit with $1 —
# on stderr when it is non-zero (a usage error).
usage() {
    local status=${1:-0} entry verb_name verb_spec verb_summary
    {
        awk 'NR<3{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
        printf '\nCommands:\n'
        for entry in "${VERBS[@]}"; do
            split_verb "$entry"
            printf '  %s %-38s %s\n' "$PROG" "$verb_name${verb_spec:+ $verb_spec}" "$verb_summary"
        done
    } >&"$(( status == 0 ? 1 : 2 ))"
    exit "$status"
}

# --- dispatch ---------------------------------------------------------------
# Words and flags may interleave; the first word is the verb, and `--` makes
# everything after it a word (a <dir> that starts with '-').
main() {
    local arg verb only_words=0; local -a words=() flags=()
    for arg in "$@"; do
        if [ "$only_words" = 1 ]; then words+=("$arg"); continue; fi
        case $arg in
            --)  only_words=1 ;;
            -?*) flags+=("$arg") ;;
            *)   words+=("$arg") ;;
        esac
    done
    # A help flag wins over everything else on the line, as with most tools.
    case " ${flags[*]-} " in *' -h '*|*' --help '*) usage 0 ;; esac
    [ ${#words[@]} -gt 0 ] || usage 1
    # An empty argument (an unset "$var") must not quietly mean $PWD.
    for arg in "${words[@]}"; do [ -n "$arg" ] || die "empty argument"; done
    verb=${words[0]}; words=("${words[@]:1}")
    check_invocation "$verb" "${#words[@]}" ${flags[@]+"${flags[@]}"}
    for arg in ${flags[@]+"${flags[@]}"}; do
        case $arg in
            --mirror)     MIRROR=1 ;;
            --force)      FORCE=1 ;;
            -y|--yes)     YES=1 ;;
            -v|--verbose) VERBOSE=1 STEPS=1 ;;
        esac
    done

    exec {LOG_FD}>&2
    [ "$VERBOSE" = 0 ] || export RCLONE_VERBOSE=1

    # init, completion and help need neither rclone nor an enclosing tree.
    case "$verb" in
        init|completion|help) ;;
        *) require rclone; find_root ;;
    esac

    "cmd_$verb" ${words[@]+"${words[@]}"}
}

# Run only when executed directly, so tests can source the helpers in isolation.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then main "$@"; fi
