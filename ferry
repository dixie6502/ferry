#!/usr/bin/env bash
#
# ferry — marker-model sync of personal projects to/from a cloud via rclone.
#
# A tree is a partial mirror of a remote, selected by `.ferry` marker files:
#
#   root   a directory whose `.ferry` holds the remote base ("Remote:Projects").
#          Found by walking UP from $PWD. Exactly one per tree.
#   unit   a leaf marker (empty `.ferry`, none below it). The granularity of every
#          transfer, git bundle and sync-state record.
#
# Directories between the root and a unit hold no marker; they are created on the
# way down by a deep `pull`/`new` and exist only to navigate.
#
# A node's remote path is DERIVED: <base> + <path under the root>. The base is
# stored once, at the root; nothing else stores a path.
#
# Files are kept out of every transfer by `.ferryignore`: one at the tree root
# (rules for every unit) and one per unit, both read relative to the unit. What
# is ignored is excluded from transfers AND from drift, so the two never disagree.
#
#   ferry init <base>     make $PWD a root holding <base>   (no nested roots)
#   ferry list [<dir>]    remote children of a node (no local dir needed)
#   ferry status [<dir>]  drift for every unit at/under $PWD
#   ferry resolve [<dir>] stage the cloud side of a conflict, to compare by hand
#   ferry sync [<dir>]    converge a unit both ways (additive; conflicts stay put)
#   ferry pull [<dir>]    materialize a unit; no arg → every unit under $PWD
#   ferry push [<dir>]    send a unit up; no arg → every unit under $PWD
#   ferry new  <name>     start a BRAND-NEW unit (cloud prefix on first push)
#   ferry mv <old> <new>  rename/move a unit or grouping dir (cloud first, then local)
#   ferry drop [<dir>]    delete LOCAL only; the cloud keeps its copy
#   ferry rm   <dir>      delete a unit BOTH sides (confirmation-gated)
#   ferry completion bash emit a bash completion script (eval from your shell rc)
#
# Flags: --mirror (propagate deletions; push/pull, single <dir> only), --force
# (skip the pre-transfer drift guard; push/pull), -y/--yes (skip prompts).
# sync takes neither: it has no direction to delete on or to prefer.
#
# Requires: bash, rclone (with the remote configured), git.

set -euo pipefail

readonly PROG=${0##*/}
readonly MARKER='.ferry'
readonly IGNORE_FILE='.ferryignore'

# Per-machine sync state, keyed by a unit's path under the root: an empty
# BASELINE file whose mtime is the last sync point, a MANIFEST of what the two
# sides shared at that point, and a cloud bit the prompt reads. Outside the
# synced tree so it never rides to the cloud.
readonly STATE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/ferry"
readonly BASELINE='synced_at'
readonly MANIFEST='manifest'

# Always keep git internals and the markers themselves out of transfers. The
# marker exclusion also protects a local `.ferry` from deletion under --mirror.
# FIND_PRUNE is the same exclusion for a local `find` walk: what is never
# transferred is never part of drift either.
readonly XFER_EXCLUDE=(--exclude '.git' --exclude '.git/**' --exclude "$MARKER")
readonly FIND_PRUNE=(-name .git -prune -o -name "$MARKER" -prune -o)

# The same two exclusions plus the unit's `.ferryignore` rules, compiled by
# load_ignore. Every reader of a unit's contents — transfer, drift check,
# remote listing, local walk — goes through these, never the base arrays: an
# exclusion that reached one and not the others would leave a file drifted
# forever (a stuck '>' in the prompt, a permanent 'remote add' in status).
UNIT_EXCLUDE=("${XFER_EXCLUDE[@]}")
UNIT_PRUNE=("${FIND_PRUNE[@]}")
IGNORE_LOADED=''

# Set by probe_unit: a unit's drift symbol, and the per-file classification
# behind it (empty unless a full comparison ran).
DRIFT=''
DRIFT_FILES=''

# --mirror: propagate deletions (single-unit push/pull only).
# --force: skip the pre-transfer drift guard (and the probe it costs).
MIRROR=0
FORCE=0

# --- helpers ----------------------------------------------------------------
die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

require() { command -v "$1" >/dev/null || die "$1 not found"; }

# Reject absolute paths and '..' traversal in a user-supplied name.
validate_name() {
    case "$1" in
        '')   die "empty name" ;;
        /*)   die "name must be relative, got '$1'" ;;
        *..*) die "'..' not allowed in '$1'" ;;
    esac
}

# Prompt for confirmation unless -y was given; abort on anything but yes.
confirm() {
    local yes=$1 msg=$2 reply
    [ "$yes" = 1 ] && return 0
    printf '%s [y/N] ' "$msg"
    read -r reply
    case "$reply" in [yY]|[yY][eE][sS]) return 0 ;; *) die "aborted" ;; esac
}

# --- tree discovery (walk up) -----------------------------------------------
# Locate the enclosing tree: the nearest ancestor (incl. $PWD) whose marker has
# content. Sets ROOT (its directory) and BASE (the remote base). Returns 1 if
# $PWD is not inside any tree — a predicate, so callers like `init` can branch.
in_tree() {
    local d; d=$(pwd -P)
    while :; do
        if [ -s "$d/$MARKER" ]; then
            ROOT=$d
            BASE=$(head -1 "$d/$MARKER")
            STATE_KEY=$(state_key "$BASE")
            return 0
        fi
        [ "$d" = / ] && return 1
        d=$(dirname "$d")
    done
}

# Same, but die when there is no enclosing tree.
find_root() { in_tree || die "not inside a ferry tree (no rooted $MARKER above $PWD)"; }

# --- derivations (no I/O) ---------------------------------------------------
# A node's remote path, derived from its position under the root.
remote_of() {
    local rel=${1#"$ROOT"}; rel=${rel#/}
    if [ -n "$rel" ]; then printf '%s/%s' "$BASE" "$rel"; else printf '%s' "$BASE"; fi
}

# A node's path under the root — the key for sync state and user-facing labels.
spec_of() { local rel=${1#"$ROOT"}; printf '%s' "${rel#/}"; }

# Absolute path of an optional <dir> argument (relative to $PWD), or $PWD itself.
# The target need not exist yet (new/pull create it).
resolve_target() {
    local here; here=$(pwd -P)
    if [ -n "${1:-}" ]; then validate_name "$1"; printf '%s/%s' "$here" "$1"
    else printf '%s' "$here"; fi
}

# --- marker-tree topology ---------------------------------------------------
# True if a directory holds a marker in a subdirectory (depth >= 2, so its own
# dir/.ferry does not count) — i.e. it is a grouping node, not a leaf.
has_sub_marker() { find "$1" -mindepth 2 -name "$MARKER" -type f -print -quit | grep -q .; }

# A unit = a directory with an EMPTY marker (the root marker has content) that is
# a leaf of the marker tree.
is_unit() { [ -f "$1/$MARKER" ] && [ ! -s "$1/$MARKER" ] && ! has_sub_marker "$1"; }

# The nearest unit at or above a directory (stopping below the root), if any —
# i.e. whether the directory sits inside already-materialized content. A unit
# marker is empty; the root marker has content, so the root never matches.
enclosing_unit() {
    local d=$1
    while [ "$d" != / ] && [ "$d" != "${ROOT:-}" ]; do
        if [ -f "$d/$MARKER" ] && [ ! -s "$d/$MARKER" ]; then printf '%s' "$d"; return 0; fi
        d=$(dirname "$d")
    done
    return 1
}

# Refuse to create/fetch a target that would sit inside an existing unit.
refuse_in_unit() {
    local u; if u=$(enclosing_unit "$(dirname "$1")"); then
        die "inside unit '$(spec_of "$u")' — already materialized content"
    fi
}

# Refuse to act on a path the shell is standing inside (a move/delete would
# leave $PWD on a dead directory).
refuse_cwd_inside() {
    local here tgt; here=$(pwd -P)
    tgt=$(cd "$1" 2>/dev/null && pwd -P || printf '%s' "$1")
    case "$here/" in "$tgt/"*) die "cd out of $1 first" ;; esac
}

# Every unit at/under a directory (walk down): EMPTY-marker dirs (the root's
# content marker is excluded by -empty) with no marker dir below them. One line
# per absolute unit path.
units_under() {
    local -a mdirs; mapfile -t mdirs < <(find "$1" -name "$MARKER" -type f -empty -printf '%h\n' | sort)
    local d e leaf
    for d in "${mdirs[@]}"; do
        leaf=1
        for e in "${mdirs[@]}"; do
            [ "$e" = "$d" ] && continue
            case "$e/" in "$d/"*) leaf=0; break ;; esac
        done
        [ "$leaf" = 1 ] && printf '%s\n' "$d"
    done
}

# --- ignore rules -----------------------------------------------------------
# `.ferryignore` keeps files out of a unit — the general form of the `.git` and
# `.ferry` exclusions above. One file may sit at the tree root (rules for every
# unit) and one in each unit; both are read RELATIVE TO THE UNIT, so a rule
# written at the root anchors at each unit's own top.
#
# `.gitignore` is deliberately NOT consulted. "Do not version-control this" is a
# different question from "do not back this up" — ferry exists for the large and
# private files git is told to skip, and `bundle_git` writes `history.bundle`
# into `.gitignore` itself, so honouring it would silently stop backing up git
# history.
#
# The grammar is restricted to what `find` and rclone match IDENTICALLY, because
# both must apply it (see UNIT_EXCLUDE). Blank lines and `#` comments are
# skipped; everything else is one of:
#
#   name          a file or directory called `name`, at any depth
#   name/         a directory called `name`, at any depth
#   *.ext         a glob (`*`, `?`, `[...]`) over a name, at any depth
#   /a/b, /a/b/   a literal path from the unit's top
#
# Rejected, loudly: `!` re-inclusion (rclone's `--exclude` has no equivalent),
# `**` (a bare name already matches at any depth), and an unanchored `a/b`
# (gitignore anchors it, rclone does not — so it must be written `/a/b`). An
# anchored pattern must be literal: `find -path` lets `*` cross a `/` and rclone
# does not, so a glob there would mean two different things.

# Quote the characters `find -path` reads as glob metacharacters, so a literal
# directory prefix never turns into a pattern.
escape_find_glob() {
    local s=$1 out='' i c
    for (( i = 0; i < ${#s}; i++ )); do
        c=${s:i:1}
        case $c in '\'|'['|']'|'*'|'?') out+='\' ;; esac
        out+=$c
    done
    printf '%s' "$out"
}

# Append one ignore file's rules to UNIT_EXCLUDE / UNIT_PRUNE, anchored at $2.
# A malformed pattern is fatal: continuing would transfer files the user asked
# to keep out, and a silently-dropped rule is exactly the kind of divergence
# between the two consumers this design exists to prevent.
#
# rclone needs both `p` and `p/**` to cover "file or directory called p" — a
# bare `--exclude p` skips the file but still descends the directory. `find`
# needs neither: `-name p -prune` covers both.
compile_ignore() {   # <ignore file> <unit dir>
    local file=$1 dir=$2 line pat dironly
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        case $line in ''|'#'*) continue ;; esac

        pat=$line dironly=0
        case $pat in */) dironly=1; pat=${pat%/} ;; esac
        case $pat in
            '')     die "$file: '$line' — empty pattern" ;;
            '!'*)   die "$file: '$line' — re-inclusion ('!') is not supported" ;;
            *'**'*) die "$file: '$line' — '**' is not supported; a bare name already matches at any depth" ;;
        esac

        if [[ $pat == */* ]]; then
            case $pat in
                /*) ;;
                *)  die "$file: '$line' — a pattern holding '/' must be anchored to the unit: write '/$pat'" ;;
            esac
            case $pat in
                *[][*?]*) die "$file: '$line' — an anchored pattern must be literal (no '*', '?' or '[')" ;;
            esac
            UNIT_PRUNE+=(-path "$(escape_find_glob "$dir$pat")")
        else
            UNIT_PRUNE+=(-name "$pat")
        fi
        [ "$dironly" = 1 ] && UNIT_PRUNE+=(-type d)
        UNIT_PRUNE+=(-prune -o)

        [ "$dironly" = 1 ] || UNIT_EXCLUDE+=(--exclude "$pat")
        UNIT_EXCLUDE+=(--exclude "$pat/**")
    done < "$file"
}

# Compile the rules that apply to one unit into UNIT_EXCLUDE / UNIT_PRUNE.
# Memoized per unit: every per-unit entry point calls it, and a walk visits each
# unit once. The unit's own file is read last, so it extends the root's rules.
load_ignore() {   # <unit dir>
    local dir=$1 f
    [ "$IGNORE_LOADED" = "$dir" ] && return 0
    UNIT_EXCLUDE=("${XFER_EXCLUDE[@]}")
    UNIT_PRUNE=("${FIND_PRUNE[@]}")
    for f in "${ROOT:+$ROOT/$IGNORE_FILE}" "$dir/$IGNORE_FILE"; do
        [ -n "$f" ] && [ -f "$f" ] && compile_ignore "$f" "$dir"
    done
    IGNORE_LOADED=$dir
}

# --- cloud probes & sync state ----------------------------------------------
# Whether a remote path is there: 0 present, 1 absent, 2 could not tell. Failing
# to *look* must never read as absence — that turns an unreachable cloud into a
# confident "nothing on the cloud". rclone answers "directory not found" (3) both
# for a path that is not there and for one behind an unreadable parent, so those
# two stay conflated; every other failure is reported as trouble.
remote_state() {
    local status=0
    rclone lsjson "$1" >/dev/null 2>&1 || status=$?
    case $status in 0) return 0 ;; 3) return 1 ;; *) return 2 ;; esac
}

# The hash algorithm the remote maintains, left in HASH_TYPE (rclone's
# preferred, first listed; empty when it holds none). Each manifest records it,
# so ancestors are always compared with the algorithm they were captured with.
# Probed once — the base is fixed for a run. A failed probe fails rather than
# recording "no hashes": that would silently downgrade a hash-capable backend
# to the mtime fallback for a whole sync cycle.
HASH_PROBED=0 HASH_TYPE=''
remote_hash_type() {
    [ "$HASH_PROBED" = 1 ] && return 0
    local out flat h=''
    out=$(rclone backend features "$BASE" 2>/dev/null) || return 1
    flat=$(tr -d '\n\t" ' <<<"$out")
    case $flat in *Hashes:\[*) h=${flat#*Hashes:[}; h=${h%%]*}; h=${h%%,*} ;; esac
    HASH_TYPE=$h HASH_PROBED=1
}

# State is keyed by the remote base as well as the unit path. Two trees can hold
# the same unit name against different remotes, and a shared key would let one
# tree's manifest and baseline answer the other's questions — with --mirror
# acting on the answer. Percent-encoding keeps the key injective: substituting
# every unsafe byte with '_' maps ':x/a_b' and ':x/a/b' onto one directory.
state_key() {
    local s=$1 out='' i c
    for (( i = 0; i < ${#s}; i++ )); do
        c=${s:i:1}
        case $c in
            [A-Za-z0-9._-]) out+=$c ;;
            *) printf -v c '%%%02X' "'$c"; out+=$c ;;
        esac
    done
    printf '%s' "$out"
}

state_path() { printf '%s/%s/%s' "$STATE_ROOT" "$STATE_KEY" "$1"; }

# How the cloud stood at the last look, and when — the bit the prompt renders.
record_remote_bit() { printf '%s %s\n' "$2" "$(date +%s)" > "$1/remote"; }

# Every cloud file of a unit, one "<mtime>;<hash>;<path>" line each — mtimes
# and hashes hold no ';', so the first two fields always split cleanly off a
# path that may. The hash field is empty when $1 gives no algorithm (then no
# ancestor could consume a hash, and computing one may cost a content read).
# Returns non-zero if the listing failed.
# Times are rendered in UTC: local-time strings go backwards across a DST
# fall-back, and the baseline cutoff compares them lexicographically.
remote_listing() {   # <hash type or ''> <remote>
    if [ -n "$1" ]; then
        TZ=UTC rclone lsf -R --files-only --format thp --separator ';' \
            --time-format max --hash "$1" "${UNIT_EXCLUDE[@]}" "$2"
    else
        TZ=UTC rclone lsf -R --files-only --format tp --separator ';' \
            --time-format max "${UNIT_EXCLUDE[@]}" "$2" | sed 's/^[^;]*;/&;/'
    fi
}

# One side of a unit, sorted, as manifest raw material. The local side is bare
# paths; the remote side is "<hash> <path>" ancestor lines hashed with $2 (a
# hash never holds a space, so the first space always ends it).
# Returns non-zero if the side could not be listed.
list_side() {
    case "$1" in
        local)  find "$2" "${UNIT_PRUNE[@]}" -type f -printf '%P\n' | sort ;;
        remote) remote_listing "${3:-}" "$2" \
                    | sed -E 's/^[^;]*;([^;]*);/\1 /' | sort -t' ' -k2 ;;
    esac
}

# A manifest headed by its version and hash type, over "<hash> <path>" lines.
# 'none' spells the empty hash type only here and in read_manifest.
manifest_v2() { printf '#ferry v2 %s\n%s' "${1:-none}" "$2"; }

# Read a manifest into the caller's M_TYPE / M_SYNCED / M_ANCESTOR (declare
# them local first). v2 gives membership and ancestor hashes; a v1 manifest
# (bare paths, pre-hash) gives membership only, every ancestor unknown.
read_manifest() {
    local line first=1 v2=0
    M_TYPE=''
    while IFS= read -r line; do
        if [ "$first" = 1 ]; then
            first=0
            case $line in
                '#ferry v2 '*) v2=1; M_TYPE=${line##* }
                               [ "$M_TYPE" = none ] && M_TYPE=''
                               continue ;;
            esac
        fi
        [ -n "$line" ] || continue
        if [ "$v2" = 1 ]; then M_SYNCED[${line#* }]=1; M_ANCESTOR[${line#* }]=${line%% *}
        else M_SYNCED[$line]=1; fi
    done < "$1"
}

# Keep the manifest body lines whose path appears in a newline-separated set.
intersect_manifest() {   # <paths> <manifest body>
    local -A keep=(); local p line
    while IFS= read -r p; do [ -n "$p" ] && keep[$p]=1; done <<<"$1"
    while IFS= read -r line; do
        if [ -n "$line" ] && [ -n "${keep[${line#* }]:-}" ]; then
            printf '%s\n' "$line"
        fi
    done <<<"$2"
}

# Record a sync point for a unit: the baseline mtime the mtime fallback
# measures drift from, a prompt bit ($3, 'sync' unless the caller still holds
# conflicts), and the MANIFEST of ancestors — the paths (with content hashes,
# in a v2 manifest) present on BOTH sides at that sync.
#
# The manifest is the ancestor set. Without it a file on only one side cannot
# be attributed: "I deleted it" and "they added it" look identical from the
# surviving copy alone, and guessing calls a file pushed late from another
# machine a local deletion, which `--mirror` then acts on.
#
# The manifest's paths are captured BEFORE the transfer and installed only once
# it succeeds: taken afterwards they would enrol a file written *during* the
# transfer, which never crossed. The baseline is stamped at completion, because
# the sync's own writes — the marker, a restored .git, and on backends that
# cannot set a destination modtime the transferred objects themselves — all
# land after the start and would otherwise read as post-sync changes.
mark_synced() {
    local spec=$1 manifest=$2 bit=${3:-sync} sd; sd=$(state_path "$spec"); mkdir -p "$sd"
    if [ -n "$manifest" ]; then printf '%s\n' "$manifest" > "$sd/$MANIFEST"
    else : > "$sd/$MANIFEST"; fi
    : > "$sd/$BASELINE"          # touched last: newer than everything it covers
    record_remote_bit "$sd" "$bit"
}

# True if a unit holds any transferable file (markers and git internals aside).
has_local_content() {
    [ -d "$1" ] || return 1
    [ -n "$(find "$1" "${UNIT_PRUNE[@]}" -type f -print -quit)" ]
}

# Did one side change a file since the last sync? Judged against the recorded
# ancestor hash when both hashes are in hand, else by whether that side's
# mtime moved past the baseline (v1 manifests, hashless entries). Reads
# classify_unit's maps through bash's dynamic scoping, so which map belongs to
# which side is decided here, not at every call site.
changed() {  # <local|remote> <path>
    local h m a=${M_ANCESTOR[$2]:-}
    case $1 in
        local)  h=${lhash[$2]:-} m=${lmoved[$2]:-} ;;
        remote) h=${rhash[$2]:-} m=${rmoved[$2]:-} ;;
    esac
    if [ -n "$h" ] && [ -n "$a" ]; then [ "$h" != "$a" ]
    else [ -n "$m" ]; fi
}

# Per-file drift for a unit, one "<class> <shape> <path>" line per differing file:
#
#   local   changed here since the last sync — a push carries it up
#   remote  changed on the cloud             — a pull brings it down
#   both    changed on both sides            — a conflict; neither is safe
#
# Direction cannot come from the diff: two content checks share no common
# ancestor, so they cannot tell "I changed it" from "we both changed it". The
# ancestor is the MANIFEST. Its membership answers presence questions — whether
# a one-sided file left one side or arrived on the other is visible in nothing
# the surviving copy carries, and a directory's mtime is too coarse to stand in
# (one unrelated add stamps it for every file). Its recorded hashes answer
# content questions: a side changed a file iff its current hash differs from
# the ancestor's — immune to the mtimes transfers preserve (a file edited on
# another machine before our baseline and pushed after it arrives with a
# pre-baseline mtime, yet is still a cloud change).
#
# Where a hash is missing (a v1 manifest, a backend entry without one) the
# fallback is mtimes against the baseline ($base, whose mtime is the last sync
# point): rclone preserves source mtimes on transfer, so right after a sync
# both sides predate the baseline and only later writes stand out. The cutoff
# is strict and keeps full precision — truncated to the second it would catch
# the sync's own tail writes, landing in the baseline's second, as far-side
# changes. `find -newer` applies the same strict comparison locally.
#
# The shape says how the file differs, and it is what decides whether a
# transfer can *destroy* anything: only a file present on both sides ('edit')
# is ever overwritten by a copy.
#
#   *  differs      edit;   one side changed → that side | else → both
#   +  local-only   not in manifest → local add | changed here → both delete | else remote delete
#   -  remote-only  not in manifest → remote add | changed there → both delete | else local delete
#
# A file rclone could not read ('!') is reported 'both edit': what is unknown blocks.
# Returns non-zero if the cloud could not be read — the caller must not read that
# as "no differences" (see probe_unit).
classify_unit() {
    local dir=$1 rp=$2 sd=$3 base=$3/$BASELINE
    local -A M_SYNCED=() M_ANCESTOR=() lmoved=() lhash=() rmoved=() rhash=()
    local M_TYPE='' line flag cls shape p h i lch rch
    read_manifest "$sd/$MANIFEST"

    while IFS= read -r p; do lmoved[$p]=1; done < <(
        find "$dir" "${UNIT_PRUNE[@]}" -type f -newer "$base" -printf '%P\n')

    # rclone exits 1 both for "differences found" (the normal case here) and for
    # trouble, and downgrades a directory it could not list to a stderr tally
    # while still reporting that whole subtree as missing on the far side — which
    # would forge a presence change. Its error counter tallies each difference
    # *plus* each real failure, so an excess over the difference count is the
    # signal that something went unread — and a summary the counters cannot be
    # read from is itself trouble, never a clean diff. Report and log share one
    # stream so neither needs a temp file: every report line is "<flag> <path>",
    # every log line starts with rclone's timestamp.
    # --log-format pinned: the summary parse below keys on the timestamp
    # prefix, and a user's RCLONE_LOG_FORMAT would otherwise change it.
    local output status=0 differences errors
    output=$(rclone check --combined - --log-format 'date,time' \
        "${UNIT_EXCLUDE[@]}" "$dir" "$rp" 2>&1) || status=$?
    if [ "$status" -gt 1 ]; then return 1; fi
    if [ "$status" = 1 ]; then
        # Counters come only from the timestamped NOTICE summary lines, matched
        # to the line's end — a report line is "<flag> <path>", and a path such
        # as "0 errors while checking.txt" could otherwise spoof them.
        differences=$(sed -nE \
            's|^[0-9]{4}/.* NOTICE: .*[^0-9]([0-9]+) differences found$|\1|p' \
            <<<"$output" | tail -1)
        [ -n "$differences" ] || return 1
        errors=$(sed -nE \
            's|^[0-9]{4}/.* NOTICE: .*[^0-9]([0-9]+) errors while checking$|\1|p' \
            <<<"$output" | tail -1)
        [ "${errors:-0}" -le "$differences" ] || return 1
    fi

    # One pass over the report — the "<flag> <path>" grammar is parsed only
    # here (a path may hold spaces; '=' lines are identical files).
    local -a flags=() paths=()
    local -A flagged=()
    while IFS= read -r line; do
        case $line in [-+*!]' '*) ;; *) continue ;; esac
        flags+=("${line:0:1}"); paths+=("${line:2}"); flagged[${line:2}]=1
    done <<<"$output"
    [ ${#paths[@]} -gt 0 ] || return 0    # nothing differs: no listing to consult

    # One remote listing carries every cloud file's current hash (primary) and
    # mtime (fallback); only the flagged files are ever consulted, so only they
    # are kept. Times compare as strings: 'max' keeps the fixed
    # "Y-m-d H:M:S.ns" layout, where lexicographic and chronological order
    # agree, and the baseline cutoff keeps the same precision.
    local cutoff listing rest
    cutoff=$(TZ=UTC date '+%Y-%m-%d %H:%M:%S.%N' -r "$base")
    listing=$(remote_listing "$M_TYPE" "$rp" 2>/dev/null) || return 1
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        rest=${line#*;}; p=${rest#*;}
        [ -n "${flagged[$p]:-}" ] || continue
        rhash[$p]=${rest%%;*}
        [[ ${line%%;*} > $cutoff ]] && rmoved[$p]=1
    done <<<"$listing"

    # Current local hashes — only for flagged files with an ancestor hash to
    # compare against; hashing is O(content), so never the whole unit. An
    # ancestor hash implies a v2 manifest, so M_TYPE is set here.
    local -a lneed=()
    for i in "${!paths[@]}"; do
        case ${flags[$i]} in
            '*'|'+') [ -n "${M_ANCESTOR[${paths[$i]}]:-}" ] && lneed+=("${paths[$i]}") ;;
        esac
    done
    if [ ${#lneed[@]} -gt 0 ]; then
        while IFS= read -r line; do
            h=${line%%  *}
            case $h in ''|*[!0-9a-f]*) continue ;; esac
            lhash[${line#*  }]=$h
        done < <(printf '%s\n' "${lneed[@]}" |
            rclone hashsum "$M_TYPE" --files-from-raw - "$dir" 2>/dev/null)
    fi

    for i in "${!paths[@]}"; do
        flag=${flags[$i]} p=${paths[$i]} shape=edit
        case "$flag" in
            '*') lch=0; changed local "$p" && lch=1
                 rch=0; changed remote "$p" && rch=1
                 case "$lch$rch" in
                     10) cls=local ;; 01) cls=remote ;; *) cls=both ;;    # 00: unattributable
                 esac ;;
            '+') shape=delete
                 if [ -z "${M_SYNCED[$p]:-}" ]; then cls=local shape=add  # not shared last sync
                 elif changed local "$p"; then cls=both                   # edited here, dropped there
                 else cls=remote; fi ;;                                   # the cloud dropped it
            '-') shape=delete
                 if [ -z "${M_SYNCED[$p]:-}" ]; then cls=remote shape=add # never here: it arrived there
                 elif changed remote "$p"; then cls=both                  # deleted here, changed there
                 else cls=local; fi ;;                                    # deleted here
            '!') cls=both ;;
        esac
        printf '%s %s %s\n' "$cls" "$shape" "$p"
    done
}

# Fold classification lines (stdin) into the two drift bits, "<up><down>".
drift_bits() {
    local up=0 down=0 cls
    while read -r cls _; do
        case "$cls" in
            local)  up=1 ;;
            remote) down=1 ;;
            both)   up=1; down=1 ;;
        esac
    done
    printf '%s%s' "$up" "$down"
}

# Render drift bits as the symbol the user reads:
#   =  in sync    >  local ahead    <  cloud ahead    <>  diverged (both changed)
drift_symbol() {
    case "$1" in 00) printf '=' ;; 10) printf '>' ;; 01) printf '<' ;; 11) printf '<>' ;; esac
}

# Split one classification line into the caller's cls / shape / path — the
# only parser of classify_unit's output grammar. Split by hand rather than by
# `read` word-splitting, which eats leading spaces in the path.
drift_fields() {
    cls=${1%% *}; local rest=${1#* }
    shape=${rest%% *}; path=${rest#* }
}

# Render a classification block: one indented "<class> <shape> <path>" per
# line, sorted.
print_drift_files() {
    local line cls shape path
    while IFS= read -r line; do
        drift_fields "$line"
        printf '    %-6s %-6s %s\n' "$cls" "$shape" "$path"
    done < <(sort <<<"$1")
}

# Set DRIFT (and DRIFT_FILES where a full comparison ran) for a unit, and refresh
# the prompt's cloud bit. Globals rather than output: cmd_status and the transfer
# guard need both halves, and a command substitution would lose the second.
# DRIFT is '?' when the cloud could not be read — never a confident symbol.
probe_unit() {
    local dir=$1 rp sd base bits reachable=0
    load_ignore "$dir"
    rp=$(remote_of "$dir"); sd=$(state_path "$(spec_of "$dir")"); base=$sd/$BASELINE
    DRIFT_FILES=''

    remote_state "$rp" || reachable=$?
    if [ "$reachable" = 2 ]; then
        DRIFT='?'; return 0          # could not look; see the '?' note below
    elif [ "$reachable" = 1 ]; then
        # Nothing on the cloud (never pushed, or an empty unit on an object store
        # that cannot hold empty dirs): local content is unpushed, empty is in sync.
        if has_local_content "$dir"; then bits=10; else bits=00; fi
    elif [ -d "$dir" ] && [ -e "$base" ] && [ -e "$sd/$MANIFEST" ]; then
        if DRIFT_FILES=$(classify_unit "$dir" "$rp" "$sd"); then
            bits=$(drift_bits <<<"$DRIFT_FILES")
        else
            # The cloud could not be read. Claiming '=' here would be a lie the
            # prompt then repeats, so report '?' and leave the stored bit — and
            # its age, which drives the prompt's staleness marker — untouched.
            DRIFT_FILES=''; DRIFT='?'; return 0
        fi
    elif has_local_content "$dir"; then
        bits=11   # no baseline: both sides hold content, direction unknowable
    else
        bits=01   # no baseline, nothing local to lose — a pull is a pure fetch
    fi
    DRIFT=$(drift_symbol "$bits")

    # Keep the prompt's cloud bit fresh. It stores 'diverged' rather than folding
    # it into 'behind' so the conservative half of a '<>' survives: the prompt's
    # own local check is mtime-only and cannot see a same-mtime conflict.
    mkdir -p "$sd"
    case "$bits" in
        11) record_remote_bit "$sd" diverged ;;
        01) record_remote_bit "$sd" behind ;;
        *)  record_remote_bit "$sd" sync ;;
    esac
}

# Move bytes src -> dst, excluding git internals and markers. mirror=1 propagates
# deletions (rclone sync); otherwise additive (rclone copy).
#
# When hashes drive attribution they must drive the skip rule too: rclone's
# default skips a file whose size and modtime match even when content differs,
# so a same-size preserved-mtime edit would stay untransferred while its hash
# is recorded as the shared ancestor — and a later guard-approved transfer
# would overwrite the unseen edit. --checksum makes "skipped" mean "identical",
# which is what mark_synced records.
# Filter and skip rule differ by shape. Whole tree: the usual exclusions, and
# --checksum whenever hashes drive attribution — rclone's default skip
# (size+modtime) would leave a same-size preserved-mtime edit untransferred
# while its hash is recorded as the shared ancestor, arming a later
# guard-approved transfer to overwrite the unseen edit; with --checksum,
# "skipped" means "identical", which is what mark_synced records. A path list
# ($3, newline-separated): every listed file is known to differ or be
# one-sided, so the copy is inevitable — --ignore-times forces it instead of
# re-verifying. rclone refuses every other filter beside --files-from-raw (raw:
# the plain variant reads '#'/';' names as comments), which is safe here: the
# lists come from a classification that already ran under UNIT_EXCLUDE, so
# nothing ignored can reach one.
transfer() {
    local src=$1 dst=$2 files=${3:-} verb=copy
    [ "$MIRROR" = 1 ] && verb=sync
    remote_hash_type || return 1
    if [ -n "$files" ]; then
        # Fed on stdin: rclone re-reads the filter file while initialising, so
        # a process-substitution path would already be gone.
        printf '%s\n' "$files" | rclone "$verb" --files-from-raw - \
            --ignore-times --progress "$src" "$dst"
    else
        local -a flags=()
        [ -n "$HASH_TYPE" ] && flags+=(--checksum)
        rclone "$verb" ${flags[@]+"${flags[@]}"} "${UNIT_EXCLUDE[@]}" --progress "$src" "$dst"
    fi
}

# --- git history sidecar (carried from prj) ---------------------------------
# Reattach git history from history.bundle to a freshly pulled tree, without
# overwriting files. Only when a bundle exists and .git does not.
restore_git() {
    local dir=$1 bundle="$1/history.bundle" branch
    [ -f "$bundle" ] || return 0
    [ -d "$dir/.git" ] && return 0

    printf '%s: restoring git history from history.bundle\n' "$PROG"
    git -C "$dir" init -q
    git -C "$dir" symbolic-ref HEAD refs/heads/__ferry_restore__
    git -C "$dir" fetch -q "$bundle" 'refs/heads/*:refs/heads/*' 'refs/tags/*:refs/tags/*'

    local branches; branches=$(git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads/)
    branch=$(grep -Ex 'main|master' <<<"$branches" | head -1 || true)
    [ -n "$branch" ] || branch=$(head -1 <<<"$branches")
    [ -n "$branch" ] || { printf '%s: bundle has no branches; skipping\n' "$PROG" >&2; return 0; }

    git -C "$dir" symbolic-ref HEAD "refs/heads/$branch"
    git -C "$dir" reset -q
}

# Snapshot git history into a single file the next push carries up.
bundle_git() {
    local dir=$1
    [ -d "$dir/.git" ] || return 0

    printf '%s: bundling git history\n' "$PROG"
    git -C "$dir" bundle create "$dir/.history.bundle.tmp" --all
    mv "$dir/.history.bundle.tmp" "$dir/history.bundle"

    if [ -f "$dir/.gitignore" ] && ! grep -qxF 'history.bundle' "$dir/.gitignore"; then
        printf 'history.bundle\n' >> "$dir/.gitignore"
        printf '%s: added history.bundle to .gitignore\n' "$PROG"
    fi
}

# --- transfer guard ---------------------------------------------------------
# Refuse a transfer that would destroy what the other side changed since the last
# sync — git's non-fast-forward refusal, and the payoff for making '<>' mean
# something. What each mode can destroy differs, so the rule does too:
#
#   plain copy  overwrites only files that exist on BOTH sides, so an 'edit' on
#               the far side is the whole hazard. A file added or deleted on one
#               side is untouchable by it — which is why deleting a file locally
#               does not stand in the way of pulling (the pull simply brings it
#               back), and why an unpushed new file does not either.
#   --mirror    also deletes on the far side, so any far-side change counts and
#               the transfer must run with the drift.
#
# Costs one probe per unit, which --force skips along with the block itself.
guard_transfer() {
    local verb=$1 dir=$2 reason='' line cls shape path
    [ "$FORCE" = 1 ] && return 0
    probe_unit "$dir"

    case "$DRIFT" in
        '?')  reason='unknown: the cloud could not be read' ;;
        '<>') [ -n "$DRIFT_FILES" ] ||
                  reason='diverged: never synced from this machine, so neither side is known to be newer' ;;
    esac

    # The far side is the one this transfer writes over.
    local far=remote; [ "$verb" = pull ] && far=local
    local -a blocking=(); local saw_both=0
    if [ -z "$reason" ]; then
        while IFS= read -r line; do
            drift_fields "$line"
            case "$cls" in "$far"|both) ;; *) continue ;; esac
            if [ "$MIRROR" = 1 ] || [ "$shape" = edit ]; then
                blocking+=("$path")
                [ "$cls" = both ] && saw_both=1
            fi
        done <<<"$DRIFT_FILES"
        if [ ${#blocking[@]} -gt 0 ]; then
            if [ "$saw_both" = 1 ]; then reason='diverged: both sides changed since the last sync'
            elif [ "$MIRROR" = 1 ]; then reason="--mirror would delete or overwrite changes on the $far side"
            elif [ "$verb" = push ]; then reason='the cloud has edits this push would overwrite'
            else reason='you have edits this pull would overwrite'; fi
        fi
    fi
    [ -n "$reason" ] || return 0

    printf '%s: refusing to %s %s — %s\n' "$PROG" "$verb" "$(spec_of "$dir")" "$reason" >&2
    [ ${#blocking[@]} -eq 0 ] || printf '    %s\n' "${blocking[@]}" >&2
    if [ "$DRIFT" = '?' ]; then
        printf '%s: retry when the cloud is reachable, or override with --force\n' "$PROG" >&2
    else
        printf "%s: inspect it with '%s resolve', or override with --force\n" "$PROG" "$PROG" >&2
    fi
    return 1
}

# --- per-unit operations ----------------------------------------------------
# Each returns non-zero (rather than dying) so a walk can tally and carry on.
pull_unit() {
    local dir=$1 rp manifest; rp=$(remote_of "$dir")
    load_ignore "$dir"
    guard_transfer pull "$dir" || return 1
    # An additive pull leaves cloud ⊆ local, so the cloud's list — hashes
    # included — is the set the two sides will share. A listing that fails must
    # fail the transfer, not quietly record an empty ancestor set.
    remote_hash_type || return 1
    manifest=$(list_side remote "$rp" "$HASH_TYPE") || return 1
    mkdir -p "$dir" || return 1
    transfer "$rp" "$dir" || return 1
    : > "$dir/$MARKER"            # confer/refresh unit status (empty marker)
    restore_git "$dir"
    mark_synced "$(spec_of "$dir")" "$(manifest_v2 "$HASH_TYPE" "$manifest")"
}

push_unit() {
    local dir=$1 rp paths; rp=$(remote_of "$dir")
    load_ignore "$dir"
    [ -d "$dir" ] || { printf '%s: no local dir %s\n' "$PROG" "$dir" >&2; return 1; }
    guard_transfer push "$dir" || return 1
    bundle_git "$dir" || return 1          # before the snapshot: the bundle is content
    # An additive push leaves local ⊆ cloud, so the local list is the shared
    # set: its paths captured BEFORE the transfer, their hashes read AFTER —
    # exactly sync_point's recipe.
    paths=$(list_side local "$dir") || return 1
    transfer "$dir" "$rp" || return 1
    : > "$dir/$MARKER"
    sync_point "$rp" "$(spec_of "$dir")" "$paths"
}

# Record the post-sync ancestors: what the cloud now shares with local — the
# remote listing intersected with the caller's pre-transfer path list, so a
# file that arrived on either side *during* the sync never enrols. An empty
# list short-circuits: nothing is shared, and there may be no remote prefix to
# list (an empty unit's push creates none). Still-conflicted paths keep their
# previous ancestor line instead of the cloud's current hash: both sides still
# differ from it, so they keep reading 'both' and `resolve` keeps working
# across syncs — and the prompt bit records 'diverged', never a clean 'sync'.
sync_point() {   # <rp> <spec> <local paths> [<conflicted path>...]
    local rp=$1 spec=$2 keep=$3; shift 3
    remote_hash_type || return 1
    local body='' line p
    if [ -n "$keep" ]; then
        body=$(list_side remote "$rp" "$HASH_TYPE") || return 1
        body=$(intersect_manifest "$keep" "$body")
    fi
    if [ $# -gt 0 ]; then
        local -A M_SYNCED=() M_ANCESTOR=() confl=(); local M_TYPE='' out=''
        read_manifest "$(state_path "$spec")/$MANIFEST"
        for p in "$@"; do confl[$p]=1; done
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            [ -n "${confl[${line#* }]:-}" ] || out+=$line$'\n'
        done <<<"$body"
        for p in "$@"; do out+="${M_ANCESTOR[$p]:-} $p"$'\n'; done
        body=${out%$'\n'}
    fi
    local bit=sync; [ $# -eq 0 ] || bit=diverged
    mark_synced "$spec" "$(manifest_v2 "$HASH_TYPE" "$body")" "$bit"
}

# Converge a unit with the cloud: carry each side's changes to the other in
# one run — additive both ways, toward the union (a deletion on one side is
# restored from the other; propagating deletions stays with push/pull
# --mirror). A file changed on BOTH sides moves in neither direction: sync
# converges everything safe and leaves each conflict in place for `resolve`.
sync_unit() {
    local dir=$1 rp spec; rp=$(remote_of "$dir"); spec=$(spec_of "$dir")
    load_ignore "$dir"
    bundle_git "$dir" || return 1   # before the probe: the bundle is content to classify
    probe_unit "$dir"

    case "$DRIFT" in
        '?') printf '%s: cannot read the cloud for %s\n' "$PROG" "$spec" >&2; return 1 ;;
        '=') # Content agrees, but the ancestors may not: a conflict reconciled
             # by hand leaves the manifest holding versions neither side has,
             # and the next edit would read 'both' against them. So re-record
             # unconditionally — the stored prompt bit cannot stand in for
             # "manifest is current", since any `status` over agreeing content
             # writes 'sync' regardless of what the manifest holds.
             local keep0; keep0=$(list_side local "$dir") || return 1
             sync_point "$rp" "$spec" "$keep0" || return 1
             printf '%s: %s in sync\n' "$PROG" "$spec"
             return 0 ;;
    esac
    if [ -z "$DRIFT_FILES" ]; then
        case "$DRIFT" in
            '>') push_unit "$dir"; return ;;   # no cloud prefix yet: sync = first push
            '<') pull_unit "$dir"; return ;;   # nothing local to lose: sync = plain pull
        esac
        printf '%s: %s has never been synced from this machine; choose a side\n' "$PROG" "$spec" >&2
        printf "%s: with '%s push --force' or '%s pull --force'\n" "$PROG" "$PROG" "$PROG" >&2
        return 1
    fi

    local line cls shape path
    local -a up=() down=() conflicts=()
    while IFS= read -r line; do
        drift_fields "$line"
        case "$cls:$shape" in
            local:delete)  down+=("$path") ;;  # deleted here — the union restores it
            local:*)       up+=("$path") ;;    # edited/added here — carry it up
            remote:delete) up+=("$path") ;;    # dropped there — restore it
            remote:*)      down+=("$path") ;;  # edited/added there — bring it down
            *)             conflicts+=("$path") ;;  # 'both': neither direction is safe
        esac
    done <<<"$DRIFT_FILES"

    local keep; keep=$(list_side local "$dir") || return 1
    if [ ${#down[@]} -gt 0 ]; then
        transfer "$rp" "$dir" "$(printf '%s\n' "${down[@]}")" || return 1
        keep+=$'\n'$(printf '%s\n' "${down[@]}")
    fi
    if [ ${#up[@]} -gt 0 ]; then
        transfer "$dir" "$rp" "$(printf '%s\n' "${up[@]}")" || return 1
    fi
    : > "$dir/$MARKER"
    restore_git "$dir"
    sync_point "$rp" "$spec" "$keep" ${conflicts[@]+"${conflicts[@]}"} || return 1

    printf '%s: %s: %d up, %d down\n' "$PROG" "$spec" "${#up[@]}" "${#down[@]}"
    if [ ${#conflicts[@]} -gt 0 ]; then
        printf '%s: %d conflicted, untouched on both sides:\n' "$PROG" "${#conflicts[@]}" >&2
        printf '%s\n' "${conflicts[@]}" | sort | sed 's/^/    /' >&2
        printf "%s: inspect with '%s resolve %s'\n" "$PROG" "$PROG" "$spec" >&2
        return 1
    fi
}

# Apply a per-unit op (pull_unit|push_unit|sync_unit) across units, continuing
# past failures and printing a tally. Returns non-zero if any failed.
run_batch() {
    local op=$1; shift
    local n=$# i=0 ok=0 dir; local -a failed=()
    for dir in "$@"; do
        i=$((i + 1))
        local spec; spec=$(spec_of "$dir")
        printf '%s: [%d/%d] %s %s\n' "$PROG" "$i" "$n" "${op%_unit}" "$spec"
        if "$op" "$dir"; then ok=$((ok + 1))
        else failed+=("$dir"); printf '%s: FAILED %s\n' "$PROG" "$spec" >&2; fi
    done
    if [ ${#failed[@]} -gt 0 ]; then
        local -a fs=(); for dir in "${failed[@]}"; do fs+=("$(spec_of "$dir")"); done
        printf '%s: %d/%d ok, %d failed: %s\n' "$PROG" "$ok" "$n" "${#failed[@]}" "${fs[*]}" >&2
        return 1
    fi
    printf '%s: %d/%d ok\n' "$PROG" "$ok" "$n"
}

# The no-arg walk: run a per-unit op over every unit under $PWD. Never
# mirrors — deletion-propagation is a single-unit-only opt-in.
walk_units() {
    local op=$1 here; here=$(pwd -P)
    local -a list; mapfile -t list < <(units_under "$here")
    [ ${#list[@]} -gt 0 ] || { printf '%s: no units under %s\n' "$PROG" "$here"; return 0; }
    run_batch "$op" "${list[@]}"
}

# Resolve a verb's target to the unit it acts on: the argument if given, else the
# unit enclosing $PWD. Dies if neither yields a unit.
unit_target() {
    local t
    if [ -n "${1:-}" ]; then t=$(resolve_target "$1")
    else t=$(enclosing_unit "$(pwd -P)") || die "not inside a unit; pass <dir>"; fi
    is_unit "$t" || die "not a unit: $(spec_of "$t")"
    printf '%s' "$t"
}

# --- verbs ------------------------------------------------------------------
cmd_init() {
    local base=${1:-}
    [ -n "$base" ] || die "usage: $PROG init <remote:path>"
    case "$base" in *:*) ;; *) die "base must look like 'remote:path', got '$base'" ;; esac
    in_tree && die "already inside a tree rooted at $ROOT"
    [ -e "$PWD/$MARKER" ] && die "$MARKER already exists here"
    printf '%s\n' "$base" > "$PWD/$MARKER"
    printf '%s: initialized root at %s -> %s\n' "$PROG" "$(pwd -P)" "$base"
}

cmd_list() {
    rclone lsf --dirs-only --format "tp" --separator '  ' \
        "$(remote_of "$(resolve_target "${1:-}")")" | sort -k3
}

# Drift for every unit at/under the target (or $PWD): one symbol+spec row each.
# For a single unit, also the per-file classification behind its symbol.
cmd_status() {
    local target; target=$(resolve_target "${1:-}")
    local -a units; mapfile -t units < <(units_under "$target")
    [ ${#units[@]} -gt 0 ] || die "no units under $(spec_of "$target")"

    local u
    for u in "${units[@]}"; do
        probe_unit "$u"
        printf '%-3s %s\n' "$DRIFT" "$(spec_of "$u")"
    done

    # A single unit leaves its own detail in DRIFT_FILES.
    if [ ${#units[@]} -eq 1 ] && [ -n "$DRIFT_FILES" ]; then
        print_drift_files "$DRIFT_FILES"
    fi
}

# Stage the cloud side of a conflict so it can be compared with ordinary tools.
# ferry does not merge — it has no third version to merge against, and a
# single-user tool with git available per unit does not need one. It makes the
# other version *available* and leaves the decision to you. The copy lands in the
# unit's state dir: outside the tree, so it is never transferred, and `drop`/`rm`
# already take it away with the unit.
cmd_resolve() {
    local target; target=$(unit_target "${1:-}")
    local spec rp stage line; spec=$(spec_of "$target"); rp=$(remote_of "$target")
    stage=$(state_path "$spec")/conflict
    probe_unit "$target"

    case "$DRIFT" in
        '?')  die "cannot read the cloud for $spec — nothing to compare against" ;;
        '<>') ;;
        *)    rm -rf "$stage"
              printf '%s: no conflict in %s (%s)\n' "$PROG" "$spec" "$DRIFT"; return 0 ;;
    esac

    # A '<>' with no per-file detail is the no-baseline case: nothing here has
    # ever been reconciled, so there is no conflicting subset to single out.
    if [ -z "$DRIFT_FILES" ]; then
        rm -rf "$stage"
        printf '%s: %s has never been synced from this machine, so both sides are\n' "$PROG" "$spec"
        printf '  unreconciled in full. Compare with '\''rclone ls %s'\'', then push or pull\n' "$rp"
        printf '  with --force to choose a side.\n'
        return 0
    fi

    # Everything the cloud touched — the versions you cannot see from here. Files
    # only you changed need no staging: your copy is already the one in hand.
    local -a wanted=(); local -A label=(); local cls shape rest path
    while IFS= read -r line; do
        cls=${line%% *}; rest=${line#* }; shape=${rest%% *}; path=${rest#* }
        # A file the cloud deleted has no version to stage; the rest do.
        [ "$shape" = delete ] && continue
        case "$cls" in
            both)   wanted+=("$path"); label[$path]='changed on both sides' ;;
            remote) wanted+=("$path"); label[$path]="${shape}ed on the cloud" ;;
        esac
    done <<<"$DRIFT_FILES"
    if [ ${#wanted[@]} -eq 0 ]; then
        rm -rf "$stage"
        printf '%s: nothing of the cloud'\''s to stage for %s — it differs by deletions\n' "$PROG" "$spec"
        printf '  and changes of your own:\n'
        print_drift_files "$DRIFT_FILES"
        printf "%s: '%s push' keeps your side, '%s pull --mirror' accepts the deletions\n" \
            "$PROG" "$PROG" "$PROG"
        return 0
    fi

    # Build beside the previous staging and swap, so a failed copy never leaves
    # the user with neither. --files-from-raw because plain --files-from reads a
    # leading '#' or ';' as a comment and trims surrounding whitespace — it would
    # silently skip legitimate filenames.
    rm -rf "$stage.new"; mkdir -p "$stage.new"
    printf '%s\n' "${wanted[@]}" | rclone copy --files-from-raw - "$rp" "$stage.new" \
        || die "could not stage the cloud version of $spec"

    # rclone reports "nothing to transfer" as success, so a path the cloud turns
    # out not to hold (one attributed to a cloud-side deletion) would otherwise be
    # announced as staged. Trust the staging dir, not the exit status.
    local -a staged=() absent=()
    for path in "${wanted[@]}"; do
        if [ -e "$stage.new/$path" ]; then staged+=("$path"); else absent+=("$path"); fi
    done
    if [ ${#staged[@]} -eq 0 ]; then
        rm -rf "$stage.new" "$stage"
        printf '%s: the cloud no longer holds %s — deleted there, not edited\n' "$PROG" "${absent[*]}"
        printf "%s: '%s push --force' restores it, '%s pull --mirror' accepts the deletion\n" \
            "$PROG" "$PROG" "$PROG"
        return 0
    fi
    rm -rf "$stage"; mv "$stage.new" "$stage"

    printf '%s: the cloud version of %d file(s) is in\n  %s\n' "$PROG" "${#staged[@]}" "$stage"
    for path in "${staged[@]}"; do printf '    %s   (%s)\n' "$path" "${label[$path]}"; done
    [ ${#absent[@]} -eq 0 ] || printf '%s: deleted on the cloud, nothing to stage: %s\n' "$PROG" "${absent[*]}"
    if [ -d "$target/.git" ] && [ -e "$stage/history.bundle" ]; then
        printf '%s: the histories share a merge base, so\n' "$PROG"
        printf '  git -C %s fetch %s/history.bundle "refs/heads/*:refs/remotes/ferry/*"\n' "$target" "$stage"
        printf '  gives you the other side as branches to merge.\n'
    fi
    # Not a plain push: a merged file matches neither side, so the guard still
    # sees a conflict. Forcing is the point — you have now looked at both.
    printf "%s: reconcile in place, then '%s push --force' to publish your result\n" "$PROG" "$PROG"
}

# Create a brand-new unit locally; the cloud prefix materializes on first push.
# The named target becomes a unit at birth (empty marker); parent dirs are created
# markerless by mkdir -p. We do not pre-create the cloud folder: an empty dir is
# unrepresentable on object stores, and a never-pushed unit reads correctly anyway
# (status: '=' empty, '>' once it holds files). Refused if the cloud path exists.
cmd_new() {
    local name=${1:-}; [ -n "$name" ] || die "usage: $PROG new <name>"
    local target; target=$(resolve_target "$name")
    refuse_in_unit "$target"
    [ -e "$target" ] && die "already exists: $target"
    local rstate=0; remote_state "$(remote_of "$target")" || rstate=$?
    [ "$rstate" = 2 ] && die "cannot reach the cloud to check $(remote_of "$target")"
    [ "$rstate" = 0 ] && die "already on cloud: $(remote_of "$target") (use 'pull' to fetch it)"
    mkdir -p "$target"
    : > "$target/$MARKER"            # confer unit status at birth
    mark_synced "$(spec_of "$target")" ''
    printf '%s: created unit %s (push to materialize on the cloud)\n' "$PROG" "$(spec_of "$target")"
}

# The daily verb: direction comes from the classification, not from the user.
# The flags stay with the directional verbs — --mirror needs a side to delete
# on, --force a side to prefer — so sync takes neither.
cmd_sync() {
    local arg=${1:-}
    [ "$MIRROR" = 1 ] && die "sync converges both sides; deletions propagate via 'push --mirror'/'pull --mirror'"
    [ "$FORCE" = 1 ] && die "sync has no --force; choose a side with 'push --force' or 'pull --force'"
    if [ -n "$arg" ]; then
        local target; target=$(unit_target "$arg")
        run_batch sync_unit "$target"
        return
    fi
    walk_units sync_unit
}

cmd_pull() {
    local arg=${1:-}
    if [ -n "$arg" ]; then
        local target; target=$(resolve_target "$arg")
        is_unit "$target" || refuse_in_unit "$target"   # new unit must not nest in one
        run_batch pull_unit "$target"
        return
    fi
    [ "$MIRROR" = 1 ] && die "--mirror applies to a single <dir> only"
    walk_units pull_unit
}

cmd_push() {
    local arg=${1:-}
    if [ -n "$arg" ]; then
        local target; target=$(resolve_target "$arg")
        [ -d "$target" ] || die "no local dir: $target"
        if ! is_unit "$target"; then
            has_sub_marker "$target" && die "'$(spec_of "$target")' is a grouping node; push its units"
            refuse_in_unit "$target"
        fi
        run_batch push_unit "$target"
        return
    fi
    [ "$MIRROR" = 1 ] && die "--mirror applies to a single <dir> only"
    walk_units push_unit
}

cmd_drop() {
    local yes=$1 arg=${2:-}
    local target; target=$(unit_target "$arg")
    refuse_cwd_inside "$target"
    local spec; spec=$(spec_of "$target")
    probe_unit "$target"        # the same classifier status uses: direction matters here
    case "$DRIFT" in
        *'>'*) printf '%s: WARNING — local has changes not on the cloud (unpushed).\n' "$PROG" >&2 ;;
        '?')   printf '%s: WARNING — could not read the cloud to check for unpushed changes.\n' "$PROG" >&2 ;;
    esac
    confirm "$yes" "Delete local $target? (cloud keeps its copy)"
    rm -rf "$target"
    rm -rf "$(state_path "$spec")"
    printf '%s: dropped %s (cloud retains it)\n' "$PROG" "$spec"
}

# Delete a unit on BOTH sides. Restricted to a local unit: cloud-only paths are
# out of scope (use rclone directly), and a grouping dir is never purged wholesale.
cmd_rm() {
    local yes=$1 arg=${2:-}
    [ -n "$arg" ] || die "usage: $PROG rm <dir>"
    local target; target=$(unit_target "$arg")
    refuse_cwd_inside "$target"
    local rp spec rstate=0; rp=$(remote_of "$target"); spec=$(spec_of "$target")
    remote_state "$rp" || rstate=$?
    # Deleting only the local copy while reporting "both sides" would be a lie
    # that also loses the one copy we could still see.
    [ "$rstate" = 2 ] && die "cannot reach the cloud for $spec — refusing to delete the local copy alone"
    confirm "$yes" "DELETE BOTH local and cloud for '$spec'? (recovery depends on the remote's trash/versioning)"
    [ "$rstate" = 0 ] && rclone purge "$rp"
    [ -e "$target" ] && rm -rf "$target"
    rm -rf "$(state_path "$spec")"
    printf '%s: removed %s from both sides\n' "$PROG" "$spec"
}

# Rename/move a unit or grouping dir. Cloud is authoritative: move there first, then
# realign local and carry the sync-state subtree. Names mirror remote, so every
# descendant's derived remote follows the move for free.
cmd_mv() {
    local old=${1:-} new=${2:-}
    { [ -n "$old" ] && [ -n "$new" ]; } || die "usage: $PROG mv <old> <new>"
    validate_name "$old"; validate_name "$new"
    local old_abs new_abs; old_abs=$(resolve_target "$old"); new_abs=$(resolve_target "$new")
    refuse_cwd_inside "$old_abs"
    [ -e "$new_abs" ] && die "local target exists: $new_abs"
    local old_spec new_spec; old_spec=$(spec_of "$old_abs"); new_spec=$(spec_of "$new_abs")

    rclone moveto "$(remote_of "$old_abs")" "$(remote_of "$new_abs")"
    printf '%s: moved on cloud %s -> %s\n' "$PROG" "$old_spec" "$new_spec"

    if [ -e "$old_abs" ]; then
        mkdir -p "$(dirname "$new_abs")"
        mv "$old_abs" "$new_abs"
        printf '%s: renamed local %s -> %s\n' "$PROG" "$old_spec" "$new_spec"
    fi

    local so sn; so=$(state_path "$old_spec"); sn=$(state_path "$new_spec")
    if [ -d "$so" ]; then rm -rf "$sn"; mkdir -p "$(dirname "$sn")"; mv "$so" "$sn"; fi
}

# Emit a bash completion script for ferry; install with `eval "$(ferry completion bash)"`.
# Only bash is supported. The prompt indicator stays a separately-sourced file
# (ferry-prompt.sh), like git's git-prompt.sh vs git-completion.bash.
cmd_completion() {
    local shell=${1:-}
    case "$shell" in
        bash) ;;
        '')   die "usage: $PROG completion bash" ;;
        *)    die "unsupported shell '$shell' (only bash)" ;;
    esac
    cat <<'COMPLETION'
# bash completion for ferry — verbs, verb-specific flags, directory arguments.
_ferry() {
    local cur verb flags
    cur=${COMP_WORDS[COMP_CWORD]}

    # The verb itself.
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W 'init list status resolve sync pull push new mv drop rm completion help' -- "$cur") )
        return
    fi
    verb=${COMP_WORDS[1]}

    # Flags, offered only for the verbs that accept them.
    if [ "${cur:0:1}" = - ]; then
        flags='-h --help'
        case $verb in
            pull|push) flags="$flags --mirror --force" ;;
            drop|rm)   flags="$flags -y --yes" ;;
        esac
        COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
        return
    fi

    # Positional argument: a shell for `completion`, a directory for the rest.
    case $verb in
        completion) COMPREPLY=( $(compgen -W 'bash' -- "$cur") ) ;;
        list|status|resolve|sync|pull|push|new|mv|drop|rm)
            if declare -F _filedir >/dev/null 2>&1; then _filedir -d
            else COMPREPLY=( $(compgen -d -- "$cur") ); fi ;;
    esac
}
complete -F _ferry ferry
COMPLETION
}

usage() {
    awk 'NR<3{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
    exit "${1:-0}"
}

# --- dispatch ---------------------------------------------------------------
main() {
    [ $# -ge 1 ] || usage 1

    local verb=$1; shift
    local yes=0; local -a args=()
    for a in "$@"; do
        case "$a" in
            --mirror) MIRROR=1 ;;
            --force)  FORCE=1 ;;
            -y|--yes) yes=1 ;;
            -*)       die "unknown flag: $a" ;;
            *)        args+=("$a") ;;
        esac
    done
    set -- "${args[@]+"${args[@]}"}"

    # init and completion need neither rclone nor an enclosing tree; the rest do.
    case "$verb" in
        init|completion|help|-h|--help) ;;
        *) require rclone; find_root ;;
    esac

    case "$verb" in
        init)   cmd_init "${1:-}" ;;
        list)   cmd_list "${1:-}" ;;
        status) cmd_status "${1:-}" ;;
        resolve) cmd_resolve "${1:-}" ;;
        sync)   cmd_sync "${1:-}" ;;
        new)    cmd_new "${1:-}" ;;
        pull)   cmd_pull "${1:-}" ;;
        push)   cmd_push "${1:-}" ;;
        drop)   cmd_drop "$yes" "${1:-}" ;;
        rm)     cmd_rm "$yes" "${1:-}" ;;
        mv)     cmd_mv "${1:-}" "${2:-}" ;;
        completion) cmd_completion "${1:-}" ;;
        -h|--help|help) usage 0 ;;
        *)      die "unknown command: $verb (try: $PROG help)" ;;
    esac
}

# Run only when executed directly, so tests can source the helpers in isolation.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then main "$@"; fi
